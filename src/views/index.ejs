<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="theme-color" content="#0f172a" />
  <meta name="mobile-web-app-capable" content="yes" />
  <meta name="apple-mobile-web-app-capable" content="yes" />
  <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
  <meta name="apple-mobile-web-app-title" content="Social Jovens" />
  <link rel="manifest" href="./manifest.json?v=3" />
  <link rel="icon" type="image/png" sizes="192x192" href="./icon-192.png?v=3" />
  <link rel="apple-touch-icon" href="./icon-192.png?v=3" />
  <title>Controle Social Jovens</title>
  <script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2"></script>
  <style>
    :root {
      --bg: #0f172a;
      --surface: #1e293b;
      --surface-hover: #334155;
      --border: #334155;
      --text: #f8fafc;
      --muted: #94a3b8;
      --primary: #3b82f6;
      --primary-hover: #2563eb;
      --success: #10b981;
      --warning: #f59e0b;
      --danger: #ef4444;
    }
    * { box-sizing: border-box; margin: 0; padding: 0; }
    body {
      font-family: system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
      background-color: var(--bg);
      color: var(--text);
      line-height: 1.45;
      padding: 1.15rem;
      max-width: 1280px;
      margin: 0 auto;
    }
    header {
      display: flex;
      flex-wrap: wrap;
      justify-content: space-between;
      align-items: center;
      gap: 0.85rem;
      margin-bottom: 1.15rem;
      padding-bottom: 0.9rem;
      border-bottom: 1px solid var(--border);
    }
    .brand-box {
      display: flex;
      align-items: center;
      gap: 0.75rem;
    }
    .brand-logo {
      width: 44px;
      height: 44px;
      border-radius: 50%;
      object-fit: cover;
      border: 2px solid rgba(255, 255, 255, 0.15);
      flex-shrink: 0;
    }
    header h1 {
      font-size: 1.3rem;
      font-weight: 700;
      letter-spacing: -0.02em;
    }
    header p {
      color: var(--muted);
      font-size: 0.82rem;
    }
    .nav-tabs {
      display: flex;
      gap: 0.35rem;
      background: var(--surface);
      padding: 0.28rem;
      border-radius: 0.65rem;
      border: 1px solid var(--border);
    }
    .nav-tab {
      background: transparent;
      border: none;
      color: var(--muted);
      padding: 0.48rem 0.85rem;
      border-radius: 0.45rem;
      font-size: 0.85rem;
      font-weight: 600;
      cursor: pointer;
      transition: all 0.15s ease;
      white-space: nowrap;
    }
    .nav-tab:hover {
      color: var(--text);
      background: rgba(255, 255, 255, 0.04);
    }
    .nav-tab.active {
      background: var(--primary);
      color: #ffffff;
      box-shadow: 0 2px 8px rgba(59, 130, 246, 0.35);
    }
    .screen {
      display: none;
      animation: fadeIn 0.15s ease-out;
    }
    .screen.active {
      display: block;
    }
    @keyframes fadeIn {
      from { opacity: 0; transform: translateY(3px); }
      to { opacity: 1; transform: translateY(0); }
    }
    .event-banner {
      background: linear-gradient(135deg, rgba(30, 41, 59, 0.95), rgba(15, 23, 42, 0.95));
      border: 1px solid var(--border);
      border-left: 4px solid var(--primary);
      border-radius: 0.75rem;
      padding: 0.85rem 1rem;
      margin-bottom: 1rem;
      display: flex;
      flex-wrap: wrap;
      justify-content: space-between;
      align-items: center;
      gap: 0.75rem;
    }
    .event-banner-left {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      gap: 0.65rem;
      flex: 1;
    }
    .event-banner-metrics {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      gap: 0.6rem;
      font-size: 0.82rem;
    }
    .metric-chip {
      background: rgba(255, 255, 255, 0.05);
      border: 1px solid var(--border);
      border-radius: 0.5rem;
      padding: 0.3rem 0.65rem;
      display: inline-flex;
      align-items: center;
      gap: 0.35rem;
    }
    .stats-row {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 0.85rem;
      margin-bottom: 1.1rem;
    }
    .stat-card {
      background: var(--surface);
      border: 1px solid var(--border);
      border-radius: 0.7rem;
      padding: 0.85rem 1.05rem;
    }
    .stat-card span {
      font-size: 0.78rem;
      color: var(--muted);
      display: block;
    }
    .stat-card strong {
      display: block;
      font-size: 1.4rem;
      margin-top: 0.15rem;
      line-height: 1.2;
    }
    .stat-card small {
      font-size: 0.75rem;
      color: var(--muted);
    }
    .text-success { color: var(--success); }
    .text-warning { color: var(--warning); }
    .text-primary { color: #60a5fa; }
    .grid-2 {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(360px, 1fr));
      gap: 1rem;
      align-items: start;
    }
    .card {
      background: var(--surface);
      border: 1px solid var(--border);
      border-radius: 0.75rem;
      padding: 1.1rem;
    }
    .card h2 {
      font-size: 1rem;
      margin-bottom: 0.85rem;
      display: flex;
      justify-content: space-between;
      align-items: center;
      border-bottom: 1px solid var(--border);
      padding-bottom: 0.5rem;
    }
    form { display: flex; flex-direction: column; gap: 0.7rem; }
    label {
      font-size: 0.79rem;
      color: var(--muted);
      display: block;
      margin-bottom: 0.22rem;
      font-weight: 500;
    }
    input, select, button {
      padding: 0.55rem 0.72rem;
      border-radius: 0.5rem;
      border: 1px solid var(--border);
      background: var(--bg);
      color: var(--text);
      font-size: 0.88rem;
    }
    input:focus, select:focus {
      outline: none;
      border-color: var(--primary);
    }
    button.btn-primary {
      background: var(--primary);
      border-color: var(--primary);
      color: #fff;
      font-weight: 600;
      cursor: pointer;
      padding: 0.62rem 0.9rem;
      transition: background 0.15s;
    }
    button.btn-primary:hover { background: var(--primary-hover); }
    button.btn-secondary {
      background: var(--surface-hover);
      border-color: var(--border);
      color: var(--text);
      font-weight: 600;
      cursor: pointer;
      padding: 0.5rem 0.8rem;
    }
    button.btn-success {
      background: var(--success);
      border-color: var(--success);
      color: #fff;
      font-weight: 600;
      cursor: pointer;
    }
    button.btn-warning {
      background: rgba(245, 158, 11, 0.2);
      border: 1px solid rgba(245, 158, 11, 0.5);
      color: #fbbf24;
      font-weight: 600;
      cursor: pointer;
    }
    button.btn-edit {
      background: rgba(59, 130, 246, 0.16);
      border: 1px solid rgba(59, 130, 246, 0.4);
      color: #60a5fa;
      font-weight: 600;
      padding: 0.26rem 0.55rem;
      font-size: 0.76rem;
      cursor: pointer;
    }
    .table-wrap {
      width: 100%;
      overflow-x: auto;
      -webkit-overflow-scrolling: touch;
    }
    table {
      width: 100%;
      border-collapse: collapse;
      font-size: 0.84rem;
      margin-top: 0.2rem;
    }
    th, td {
      text-align: left;
      padding: 0.5rem 0.38rem;
      border-bottom: 1px solid var(--border);
    }
    th {
      color: var(--muted);
      font-weight: 600;
      font-size: 0.74rem;
      text-transform: uppercase;
      letter-spacing: 0.03em;
    }
    .tag {
      display: inline-block;
      padding: 0.14rem 0.48rem;
      border-radius: 0.35rem;
      font-size: 0.7rem;
      font-weight: 600;
      text-transform: uppercase;
    }
    .tag-pago, .tag-aberto { background: rgba(16, 185, 129, 0.2); color: #34d399; }
    .tag-pendente, .tag-agendado { background: rgba(245, 158, 11, 0.2); color: #fbbf24; }
    .tag-encerrado { background: rgba(148, 163, 184, 0.2); color: #cbd5e1; }
    .events-list {
      display: flex;
      flex-direction: column;
      gap: 0.8rem;
    }
    .event-item {
      background: var(--bg);
      border: 1px solid var(--border);
      border-radius: 0.65rem;
      padding: 0.9rem;
    }
    .event-item.active-event {
      border-color: var(--success);
    }
    .event-header {
      display: flex;
      justify-content: space-between;
      align-items: flex-start;
      gap: 0.5rem;
      margin-bottom: 0.65rem;
    }
    .event-metrics-grid {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 0.45rem;
      margin-bottom: 0.65rem;
    }
    .event-metric-box {
      background: var(--surface);
      border: 1px solid var(--border);
      border-radius: 0.45rem;
      padding: 0.45rem 0.55rem;
    }
    .event-metric-box small {
      font-size: 0.68rem;
      color: var(--muted);
      display: block;
    }
    .event-metric-box strong {
      font-size: 0.92rem;
      display: block;
      margin-top: 0.1rem;
    }
    .progress-bar {
      width: 100%;
      height: 6px;
      background: var(--surface);
      border-radius: 999px;
      overflow: hidden;
      margin-bottom: 0.7rem;
    }
    .progress-fill {
      height: 100%;
      background: linear-gradient(90deg, var(--primary), var(--success));
      border-radius: 999px;
      transition: width 0.25s ease;
    }
    .event-actions {
      display: flex;
      flex-wrap: wrap;
      gap: 0.45rem;
    }
    .event-actions button {
      font-size: 0.78rem;
      padding: 0.38rem 0.68rem;
    }
    .cat-pills {
      display: flex;
      flex-wrap: wrap;
      gap: 0.4rem;
      margin-top: 0.6rem;
    }
    .cat-pill {
      background: rgba(255, 255, 255, 0.06);
      border: 1px solid var(--border);
      padding: 0.2rem 0.58rem;
      border-radius: 999px;
      font-size: 0.76rem;
      color: var(--text);
    }
    .cart-box {
      background: var(--bg);
      border: 1px solid var(--border);
      border-radius: 0.55rem;
      padding: 0.65rem;
      display: flex;
      flex-direction: column;
      gap: 0.45rem;
    }
    .cart-item-row {
      display: flex;
      justify-content: space-between;
      align-items: center;
      gap: 0.5rem;
      padding: 0.4rem 0.5rem;
      background: var(--surface);
      border: 1px solid var(--border);
      border-radius: 0.45rem;
      font-size: 0.82rem;
    }
    .cart-item-controls {
      display: flex;
      align-items: center;
      gap: 0.35rem;
    }
    .cart-qty-btn {
      padding: 0.15rem 0.48rem;
      font-size: 0.8rem;
      font-weight: 700;
      background: var(--surface-hover);
      border: 1px solid var(--border);
      color: var(--text);
      border-radius: 0.35rem;
      cursor: pointer;
    }
    .cart-remove-btn {
      padding: 0.15rem 0.45rem;
      font-size: 0.76rem;
      background: rgba(239, 68, 68, 0.18);
      border: 1px solid rgba(239, 68, 68, 0.4);
      color: #f87171;
      border-radius: 0.35rem;
      cursor: pointer;
    }
    .cart-total-bar {
      display: flex;
      justify-content: space-between;
      align-items: center;
      padding-top: 0.45rem;
      border-top: 1px dashed var(--border);
      font-size: 0.9rem;
    }
    .closed-order-notice {
      background: rgba(245, 158, 11, 0.12);
      border: 1px solid rgba(245, 158, 11, 0.4);
      border-radius: 0.55rem;
      padding: 0.75rem;
      margin-bottom: 0.75rem;
      font-size: 0.82rem;
      color: #fde68a;
      display: none;
    }
    .other-pending-alert {
      background: rgba(245, 158, 11, 0.14);
      border: 1px solid rgba(245, 158, 11, 0.45);
      border-radius: 0.55rem;
      padding: 0.6rem 0.8rem;
      margin-bottom: 0.75rem;
      font-size: 0.8rem;
      color: #fbbf24;
      display: none;
      justify-content: space-between;
      align-items: center;
      gap: 0.5rem;
      flex-wrap: wrap;
    }
    #toast {
      position: fixed;
      bottom: 1rem;
      right: 1rem;
      left: 1rem;
      max-width: 420px;
      margin: 0 auto;
      background: #1e293b;
      border: 1px solid var(--primary);
      padding: 0.75rem 1rem;
      border-radius: 0.55rem;
      display: none;
      z-index: 100;
      box-shadow: 0 10px 25px rgba(0,0,0,0.5);
      text-align: center;
      font-size: 0.86rem;
    }
    @media (max-width: 768px) {
      body { padding: 0.6rem; }
      header {
        flex-direction: column;
        align-items: stretch;
        gap: 0.6rem;
        margin-bottom: 0.75rem;
        padding-bottom: 0.65rem;
      }
      .brand-logo { width: 36px; height: 36px; }
      header h1 { font-size: 1.12rem; }
      header p { font-size: 0.76rem; }
      .nav-tabs { width: 100%; justify-content: space-between; }
      .nav-tab { flex: 1; text-align: center; padding: 0.45rem 0.25rem; font-size: 0.76rem; }
      .event-banner { padding: 0.65rem 0.75rem; gap: 0.5rem; }
      .stats-row { grid-template-columns: 1fr 1fr; gap: 0.5rem; margin-bottom: 0.8rem; }
      .stats-row .stat-card:nth-child(3) { grid-column: 1 / -1; }
      .stat-card { padding: 0.6rem 0.75rem; border-radius: 0.55rem; }
      .stat-card span { font-size: 0.72rem; }
      .stat-card strong { font-size: 1.15rem; }
      .grid-2 { grid-template-columns: 1fr; gap: 0.75rem; }
      .card { padding: 0.8rem; border-radius: 0.65rem; }
      .card h2 { font-size: 0.94rem; margin-bottom: 0.65rem; padding-bottom: 0.42rem; }
      .event-metrics-grid { grid-template-columns: 1fr 1fr; }
      input, select, button { padding: 0.48rem 0.62rem; font-size: 0.84rem; }
      th, td { padding: 0.42rem 0.28rem; font-size: 0.78rem; }
    }
  </style>
</head>
<body>
  <header>
    <div class="brand-box">
      <img src="./icon-192.png?v=3" alt="Detroit Jovens" class="brand-logo" />
      <div>
        <h1>Controle Social Jovens</h1>
        <p>Eventos, Adesão, Pedidos e Produtos</p>
      </div>
    </div>
    <nav class="nav-tabs" aria-label="Navegação Principal">
      <button type="button" class="nav-tab" id="tab-events" onclick="switchScreen('events')">
        📅 Eventos & Adesão
      </button>
      <button type="button" class="nav-tab active" id="tab-orders" onclick="switchScreen('orders')">
        🛒 Caixa / Pedidos
      </button>
      <button type="button" class="nav-tab" id="tab-products" onclick="switchScreen('products')">
        📦 Produtos
      </button>
      <button type="button" class="nav-tab" id="btn-install-pwa" onclick="installPwaApp()" style="display: none; color: #34d399;">
        📲 App
      </button>
    </nav>
  </header>

  <datalist id="customers-datalist"></datalist>

  <!-- TELA 0: EVENTOS & ADESÃO -->
  <section id="screen-events" class="screen">
    <div class="stats-row">
      <div class="stat-card">
        <span>Eventos Cadastrados</span>
        <strong id="ev-stat-count">0</strong>
        <small id="ev-stat-open">0 em andamento</small>
      </div>
      <div class="stat-card">
        <span>Média de Adesão nas Sociais</span>
        <strong class="text-primary" id="ev-stat-adherence">0%</strong>
        <small id="ev-stat-buyers">0 compradores únicos no total</small>
      </div>
      <div class="stat-card">
        <span>Total Movimentado (Histórico Geral)</span>
        <strong class="text-success" id="ev-stat-revenue">R$ 0,00</strong>
        <small id="ev-stat-orders">Soma de todos os eventos</small>
      </div>
    </div>

    <div class="grid-2">
      <div class="card">
        <h2>Agendar / Criar Dia de Evento</h2>
        <form id="event-form">
          <div>
            <label for="ev-name">Nome ou Tema do Evento / Social</label>
            <input type="text" id="ev-name" placeholder="Ex: Social Pós-Culto / Noite do Hot Dog" required style="width: 100%;" />
          </div>
          <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 0.6rem;">
            <div>
              <label for="ev-date">Data do Evento</label>
              <input type="date" id="ev-date" required style="width: 100%;" />
            </div>
            <div>
              <label for="ev-attendance">Jovens Presentes (Público)</label>
              <input type="number" id="ev-attendance" min="0" placeholder="Ex: 40 (pode editar depois)" style="width: 100%;" />
            </div>
          </div>
          <div>
            <label for="ev-status">Status Inicial</label>
            <select id="ev-status" style="width: 100%;">
              <option value="aberto">Já iniciar vendas agora (Em Andamento)</option>
              <option value="agendado">Apenas Agendar Dia (Iniciar vendas depois)</option>
            </select>
          </div>
          <button type="submit" class="btn-primary">Salvar Evento</button>
        </form>
      </div>

      <div class="card">
        <h2>Histórico de Eventos & Adesão</h2>
        <div class="events-list" id="events-list-container"></div>
      </div>
    </div>
  </section>

  <!-- TELA 1: CAIXA / PEDIDOS -->
  <main id="screen-orders" class="screen active">
    <div class="event-banner">
      <div class="event-banner-left">
        <div>
          <label for="active-event-select" style="margin-bottom: 0.15rem; font-size: 0.72rem;">Evento / Dia Selecionado:</label>
          <select id="active-event-select" onchange="onChangeActiveEvent(this.value)" style="font-weight: 600; min-width: 220px;"></select>
        </div>
        <span id="active-event-badge" class="tag tag-aberto">-</span>
      </div>
      <div class="event-banner-metrics" id="active-event-metrics">
        <span class="metric-chip">👥 Presentes: <strong id="banner-attendance">0</strong> <button type="button" class="btn-edit" onclick="promptUpdateAttendance()" style="margin-left:0.25rem;">Editar</button></span>
        <span class="metric-chip">🛒 Compraram: <strong id="banner-buyers">0</strong></span>
        <span class="metric-chip">📈 Adesão: <strong class="text-primary" id="banner-adherence">-</strong></span>
      </div>
    </div>

    <section class="stats-row">
      <div class="stat-card">
        <span>Total Recebido (Pagos)</span>
        <strong class="text-success" id="stat-paid">R$ 0,00</strong>
        <small id="stat-paid-count">0 pedido(s) pago(s)</small>
      </div>
      <div class="stat-card">
        <span>Total Pendente</span>
        <strong class="text-warning" id="stat-pending">R$ 0,00</strong>
        <small id="stat-pending-count">0 pedido(s) pendente(s)</small>
      </div>
      <div class="stat-card">
        <span>Recebido por Forma de Pagamento</span>
        <div id="stat-methods" style="font-size: 0.84rem; margin-top: 0.35rem; color: var(--text);">-</div>
      </div>
    </section>

    <div class="grid-2">
      <div class="card">
        <h2>Novo Pedido</h2>
        <div id="closed-order-notice" class="closed-order-notice">
          <div style="margin-bottom: 0.45rem;" id="closed-order-text">As vendas deste evento não estão abertas no momento.</div>
          <button type="button" class="btn-success" onclick="openSelectedEventSales()" style="padding: 0.38rem 0.75rem; font-size: 0.8rem;">
            ▶ Iniciar / Reabrir Vendas deste Evento
          </button>
        </div>

        <form id="order-form">
          <div>
            <label for="order-customer">Nome do Cliente / Jovem <span style="font-weight:400;">(Sugere nomes já cadastrados)</span></label>
            <input type="text" id="order-customer" list="customers-datalist" autocomplete="off" placeholder="Ex: Lucas Mendes" required style="width: 100%;" />
          </div>
          <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 0.6rem;">
            <div>
              <label for="order-method">Forma de Pagamento</label>
              <select id="order-method" style="width: 100%;">
                <option value="pix">Pix</option>
                <option value="dinheiro">Dinheiro</option>
                <option value="cartao">Cartão</option>
              </select>
            </div>
            <div>
              <label for="order-status">Status do Pagamento</label>
              <select id="order-status" style="width: 100%;">
                <option value="pago">Pago na hora</option>
                <option value="pendente">Pendente</option>
              </select>
            </div>
          </div>
          <div style="display: grid; grid-template-columns: 1fr 78px auto; gap: 0.45rem; align-items: end;">
            <div>
              <label for="order-product">Adicionar Produto</label>
              <select id="order-product" style="width: 100%;"></select>
            </div>
            <div>
              <label for="order-qty">Qtd</label>
              <input type="number" id="order-qty" value="1" min="1" style="width: 100%;" />
            </div>
            <button type="button" class="btn-secondary" onclick="addItemToOrderCart()" style="white-space: nowrap; height: 37px;">
              + Incluir
            </button>
          </div>

          <div class="cart-box" id="order-cart-box">
            <div id="order-cart-items" style="display: flex; flex-direction: column; gap: 0.35rem;"></div>
            <div class="cart-total-bar">
              <span style="color: var(--muted); font-size: 0.8rem;" id="order-cart-count">0 item(ns) no pedido</span>
              <span>Total: <strong class="text-success" id="order-cart-total">R$ 0,00</strong></span>
            </div>
          </div>

          <button type="submit" class="btn-primary" id="order-submit-btn">Finalizar Pedido</button>
        </form>

        <h2 style="margin-top: 1.35rem;">Pedidos Registrados</h2>
        <div class="table-wrap">
          <table>
            <thead>
              <tr>
                <th>#</th>
                <th>Cliente</th>
                <th>Itens</th>
                <th>Total</th>
                <th>Status</th>
              </tr>
            </thead>
            <tbody id="orders-tbody"></tbody>
          </table>
        </div>
      </div>

      <div class="card">
        <h2>Pedidos Pendentes — Dar Baixa</h2>
        <div id="other-pending-alert" class="other-pending-alert">
          <span id="other-pending-text">Há pendências de eventos anteriores!</span>
          <button type="button" class="btn-warning" onclick="onChangeActiveEvent('all')" style="padding: 0.25rem 0.55rem; font-size: 0.75rem;">
            Ver Todos os Eventos
          </button>
        </div>
        <p style="font-size: 0.78rem; color: var(--muted); margin-bottom: 0.55rem;">
          Você pode dar baixa em pedidos pendentes a qualquer momento, mesmo após encerrar o evento:
        </p>
        <div class="table-wrap">
          <table>
            <thead>
              <tr>
                <th>#</th>
                <th>Cliente</th>
                <th>Forma</th>
                <th>Valor</th>
                <th>Ação</th>
              </tr>
            </thead>
            <tbody id="pending-tbody"></tbody>
          </table>
        </div>
      </div>
    </div>
  </main>

  <!-- TELA 2: PRODUTOS & CATEGORIAS -->
  <section id="screen-products" class="screen">
    <div class="grid-2">
      <div style="display: flex; flex-direction: column; gap: 1rem;">
        <div class="card">
          <h2 id="product-form-title">Cadastrar Novo Produto</h2>
          <form id="product-form">
            <input type="hidden" id="prod-edit-id" value="" />
            <div>
              <label for="prod-name">Nome do Produto</label>
              <input type="text" id="prod-name" placeholder="Ex: Refrigerante Lata 350ml" required style="width: 100%;" />
            </div>
            <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 0.6rem;">
              <div>
                <label for="prod-category">Categoria</label>
                <select id="prod-category" style="width: 100%;"></select>
              </div>
              <div>
                <label for="prod-price">Preço Unitário (R$)</label>
                <input type="number" id="prod-price" step="0.50" min="0" placeholder="Ex: 6.00" required style="width: 100%;" />
              </div>
            </div>
            <div>
              <label for="prod-stock">Estoque <span style="font-weight:400;">(Vazio = sem controle de estoque)</span></label>
              <input type="number" id="prod-stock" min="0" placeholder="Livre / Sem controle" style="width: 100%;" />
            </div>
            <div style="display: flex; gap: 0.5rem;">
              <button type="submit" class="btn-primary" id="prod-submit-btn" style="flex: 1;">Salvar Produto</button>
              <button type="button" class="btn-secondary" id="prod-cancel-btn" onclick="cancelEditProduct()" style="display: none;">Cancelar</button>
            </div>
          </form>
        </div>

        <div class="card">
          <h2>Categorias de Produtos</h2>
          <form id="category-form" style="flex-direction: row; gap: 0.5rem; align-items: end;">
            <div style="flex: 1;">
              <label for="cat-name">Nova Categoria</label>
              <input type="text" id="cat-name" placeholder="Ex: Salgados, Sobremesas..." required style="width: 100%;" />
            </div>
            <button type="submit" class="btn-primary" style="white-space: nowrap;">+ Criar</button>
          </form>
          <div class="cat-pills" id="categories-pills"></div>
        </div>
      </div>

      <div class="card">
        <h2>Produtos Cadastrados & Estoque</h2>
        <div class="table-wrap">
          <table>
            <thead>
              <tr>
                <th>Produto</th>
                <th>Categoria</th>
                <th>Preço</th>
                <th>Estoque</th>
                <th>Ação</th>
              </tr>
            </thead>
            <tbody id="products-tbody"></tbody>
          </table>
        </div>
      </div>
    </div>
  </section>

  <div id="toast"></div>

  <script>
    const SCHEMA_NAME = '<%= schema %>';
    const STORAGE_KEY = 'csj_db_v1';
    const EVENTS_BRIDGE_KEY = 'csj_events_bridge_v1';
    const DEFAULT_SUPABASE_URL = 'https://irlxktcyucvckejrxunk.supabase.co';
    const DEFAULT_SUPABASE_KEY = 'eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6ImlybHhrdGN5dWN2Y2tlanJ4dW5rIiwicm9sZSI6ImFub24iLCJpYXQiOjE3NTgxNTMzNTcsImV4cCI6MjA3MzcyOTM1N30.9JqCS8cN_Lzrc1BYGYmVIpF9JPyLNUmxD0hKoNhStVA';

    const fmtBRL = (v) => Number(v || 0).toLocaleString('pt-BR', { style: 'currency', currency: 'BRL' });

    function fmtDateBR(isoDate) {
      if (!isoDate) return '-';
      const parts = String(isoDate).slice(0, 10).split('-');
      if (parts.length !== 3) return isoDate;
      return `${parts[2]}/${parts[1]}/${parts[0]}`;
    }

    function normalizeCustomerKey(name) {
      return String(name || '')
        .trim()
        .toLowerCase()
        .normalize('NFD')
        .replace(/[\u0300-\u036f]/g, '')
        .replace(/\s+/g, ' ');
    }

    let cachedProducts = [];
    let cachedEvents = [];
    let orderCart = [];
    let selectedEventId = localStorage.getItem('csj_selected_event_id') || '';

    function renderOrderCart() {
      const itemsContainer = document.getElementById('order-cart-items');
      const countEl = document.getElementById('order-cart-count');
      const totalEl = document.getElementById('order-cart-total');
      if (!itemsContainer) return;

      itemsContainer.innerHTML = '';

      if (orderCart.length === 0) {
        const selEl = document.getElementById('order-product');
        const qtyEl = document.getElementById('order-qty');
        const selProd = cachedProducts.find((p) => Number(p.id) === Number(selEl && selEl.value));
        const previewQty = Math.max(1, Number((qtyEl && qtyEl.value) || 1));
        const previewTotal = selProd ? selProd.price * previewQty : 0;

        itemsContainer.innerHTML = `<div style="color:var(--muted);font-size:0.78rem;text-align:center;padding:0.2rem 0;">Toque em <strong>+ Incluir</strong> para adicionar vários produtos, ou finalize direto com o produto selecionado acima.</div>`;
        countEl.textContent = selProd ? `1 item selecionado (${previewQty}x ${selProd.name})` : '0 itens';
        totalEl.textContent = fmtBRL(previewTotal);
        return;
      }

      let totalAmount = 0;
      let totalUnits = 0;

      orderCart.forEach((item, idx) => {
        const subtotal = item.price * item.quantity;
        totalAmount += subtotal;
        totalUnits += item.quantity;

        const row = document.createElement('div');
        row.className = 'cart-item-row';
        row.innerHTML = `
          <div style="flex:1;">
            <strong>${item.quantity}x ${item.name}</strong>
            <div style="font-size:0.74rem;color:var(--muted);">${fmtBRL(item.price)} un. = <strong style="color:var(--text);">${fmtBRL(subtotal)}</strong></div>
          </div>
          <div class="cart-item-controls">
            <button type="button" class="cart-qty-btn" onclick="changeCartItemQty(${idx}, -1)">-</button>
            <button type="button" class="cart-qty-btn" onclick="changeCartItemQty(${idx}, 1)">+</button>
            <button type="button" class="cart-remove-btn" onclick="removeCartItem(${idx})">✕</button>
          </div>
        `;
        itemsContainer.appendChild(row);
      });

      countEl.textContent = `${orderCart.length} produto(s) (${totalUnits} un.)`;
      totalEl.textContent = fmtBRL(totalAmount);
    }

    function addItemToOrderCart() {
      const prodSelect = document.getElementById('order-product');
      const qtyInput = document.getElementById('order-qty');
      const prodId = Number(prodSelect.value);
      const qty = Number(qtyInput.value);

      if (!prodId || !Number.isInteger(qty) || qty <= 0) {
        showToast('Selecione um produto e uma quantidade válida.');
        return;
      }

      const prod = cachedProducts.find((p) => Number(p.id) === prodId);
      if (!prod) return;

      const existing = orderCart.find((i) => Number(i.product_id) === prodId);
      const newTotalQty = (existing ? existing.quantity : 0) + qty;

      if (prod.stock_quantity !== null && prod.stock_quantity !== undefined && newTotalQty > prod.stock_quantity) {
        showToast(`Estoque insuficiente para "${prod.name}". Disponível: ${prod.stock_quantity} un.`);
        return;
      }

      if (existing) {
        existing.quantity = newTotalQty;
      } else {
        orderCart.push({
          product_id: prod.id,
          name: prod.name,
          price: Number(prod.price),
          stock_quantity: prod.stock_quantity,
          quantity: qty
        });
      }

      qtyInput.value = '1';
      renderOrderCart();
    }

    function changeCartItemQty(index, delta) {
      const item = orderCart[index];
      if (!item) return;
      const nextQty = item.quantity + delta;
      if (nextQty <= 0) {
        orderCart.splice(index, 1);
      } else {
        if (item.stock_quantity !== null && item.stock_quantity !== undefined && nextQty > item.stock_quantity) {
          showToast(`Estoque máximo disponível para "${item.name}": ${item.stock_quantity} un.`);
          return;
        }
        item.quantity = nextQty;
      }
      renderOrderCart();
    }

    function removeCartItem(index) {
      orderCart.splice(index, 1);
      renderOrderCart();
    }

    document.getElementById('ev-date').value = new Date().toISOString().slice(0, 10);

    function switchScreen(screenName) {
      ['events', 'orders', 'products'].forEach((s) => {
        document.getElementById(`screen-${s}`).classList.toggle('active', s === screenName);
        document.getElementById(`tab-${s}`).classList.toggle('active', s === screenName);
      });
    }

    function showToast(msg) {
      const el = document.getElementById('toast');
      el.textContent = msg;
      el.style.display = 'block';
      setTimeout(() => { el.style.display = 'none'; }, 3200);
    }

    function startEditProduct(productId) {
      const prod = cachedProducts.find((p) => Number(p.id) === Number(productId));
      if (!prod) return;

      document.getElementById('prod-edit-id').value = prod.id;
      document.getElementById('prod-name').value = prod.name;
      document.getElementById('prod-category').value = prod.category_id;
      document.getElementById('prod-price').value = prod.price;
      document.getElementById('prod-stock').value =
        prod.stock_quantity === null || prod.stock_quantity === undefined ? '' : prod.stock_quantity;

      document.getElementById('product-form-title').textContent = `Editar Produto #${prod.id}`;
      document.getElementById('prod-submit-btn').textContent = 'Salvar Alterações';
      document.getElementById('prod-cancel-btn').style.display = 'inline-block';
      document.getElementById('prod-name').focus();
    }

    function cancelEditProduct() {
      document.getElementById('prod-edit-id').value = '';
      document.getElementById('prod-name').value = '';
      document.getElementById('prod-price').value = '';
      document.getElementById('prod-stock').value = '';
      document.getElementById('product-form-title').textContent = 'Cadastrar Novo Produto';
      document.getElementById('prod-submit-btn').textContent = 'Salvar Produto';
      document.getElementById('prod-cancel-btn').style.display = 'none';
    }

    function onChangeActiveEvent(val) {
      selectedEventId = String(val);
      localStorage.setItem('csj_selected_event_id', selectedEventId);
      loadDashboard();
    }

    async function setEventStatus(eventId, newStatus, openCashScreen = false) {
      const res = await fetch(`/events/${eventId}`, {
        method: 'PATCH',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ status: newStatus })
      });
      if (res.ok) {
        selectedEventId = String(eventId);
        localStorage.setItem('csj_selected_event_id', selectedEventId);
        showToast(newStatus === 'aberto' ? 'Vendas iniciadas!' : 'Evento encerrado!');
        await loadDashboard();
        if (openCashScreen) switchScreen('orders');
      } else {
        const err = await res.json();
        showToast(err.error || 'Erro ao atualizar evento');
      }
    }

    function openSelectedEventSales() {
      if (!selectedEventId || selectedEventId === 'all') return;
      setEventStatus(Number(selectedEventId), 'aberto', false);
    }

    async function promptUpdateAttendance(eventIdParam) {
      const targetId = eventIdParam || (selectedEventId !== 'all' ? Number(selectedEventId) : null);
      const ev = cachedEvents.find((e) => Number(e.id) === Number(targetId));
      if (!ev) return;
      const input = window.prompt(
        `Quantos jovens participaram/estiveram presentes no evento "${ev.name}"?`,
        String(ev.attendance_count || 0)
      );
      if (input === null) return;
      const num = Number(input);
      if (!Number.isInteger(num) || num < 0) {
        showToast('Informe um número inteiro válido >= 0.');
        return;
      }
      const res = await fetch(`/events/${ev.id}`, {
        method: 'PATCH',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ attendance_count: num })
      });
      if (res.ok) {
        showToast(`Público presente atualizado para ${num} jovens!`);
        loadDashboard();
      }
    }

    function selectEventAndOpenCash(eventId) {
      selectedEventId = String(eventId);
      localStorage.setItem('csj_selected_event_id', selectedEventId);
      loadDashboard();
      switchScreen('orders');
    }

    async function loadDashboard() {
      const [catRes, prodRes, evRes, ordRes] = await Promise.all([
        fetch('/categories'),
        fetch('/products'),
        fetch('/events'),
        fetch('/orders')
      ]);
      const categories = await catRes.json();
      const products = await prodRes.json();
      const events = await evRes.json();
      const allOrders = await ordRes.json();

      cachedProducts = products || [];
      cachedEvents = Array.isArray(events) ? events : [];

      if (!selectedEventId || (selectedEventId !== 'all' && !cachedEvents.some((e) => String(e.id) === String(selectedEventId)))) {
        const openEv = cachedEvents.find((e) => e.status === 'aberto') || cachedEvents[0];
        selectedEventId = openEv ? String(openEv.id) : 'all';
        localStorage.setItem('csj_selected_event_id', selectedEventId);
      }

      const datalist = document.getElementById('customers-datalist');
      datalist.innerHTML = '';
      const knownNamesMap = new Map();
      (allOrders || []).forEach((o) => {
        const k = normalizeCustomerKey(o.customer_name);
        if (k && !knownNamesMap.has(k)) knownNamesMap.set(k, o.customer_name.trim());
      });
      knownNamesMap.forEach((displayName) => {
        const opt = document.createElement('option');
        opt.value = displayName;
        datalist.appendChild(opt);
      });

      const openEventsCount = cachedEvents.filter((e) => e.status === 'aberto').length;
      const totalRevenueAll = cachedEvents.reduce((s, e) => s + (e.total_sales || 0), 0);
      const eventsWithAdherence = cachedEvents.filter((e) => e.adherence_rate !== null);
      const avgAdherence = eventsWithAdherence.length
        ? Number((eventsWithAdherence.reduce((s, e) => s + e.adherence_rate, 0) / eventsWithAdherence.length).toFixed(1))
        : 0;

      document.getElementById('ev-stat-count').textContent = String(cachedEvents.length);
      document.getElementById('ev-stat-open').textContent = `${openEventsCount} em andamento`;
      document.getElementById('ev-stat-adherence').textContent = `${avgAdherence}%`;
      document.getElementById('ev-stat-buyers').textContent = `${knownNamesMap.size} jovens compradores únicos`;
      document.getElementById('ev-stat-revenue').textContent = fmtBRL(totalRevenueAll);

      const evListEl = document.getElementById('events-list-container');
      evListEl.innerHTML = '';
      if (cachedEvents.length === 0) {
        evListEl.innerHTML = '<p style="color:var(--muted);text-align:center;padding:1rem;">Nenhum evento cadastrado ainda.</p>';
      } else {
        cachedEvents.forEach((ev) => {
          const isSelected = String(ev.id) === String(selectedEventId);
          const statusLabel = ev.status === 'aberto' ? 'Em Andamento' : ev.status === 'agendado' ? 'Agendado' : 'Encerrado';
          const adherenceText = ev.adherence_rate !== null ? `${ev.adherence_rate}%` : 'Definir público';
          const pctWidth = ev.adherence_rate !== null ? Math.min(100, Math.round(ev.adherence_rate)) : 0;

          let actionsHtml = '';
          if (ev.status === 'agendado') {
            actionsHtml = `
              <button type="button" class="btn-success" onclick="setEventStatus(${ev.id}, 'aberto', true)">▶ Iniciar Vendas</button>
              <button type="button" class="btn-secondary" onclick="promptUpdateAttendance(${ev.id})">👥 Informar Presentes</button>
            `;
          } else if (ev.status === 'aberto') {
            actionsHtml = `
              <button type="button" class="btn-primary" onclick="selectEventAndOpenCash(${ev.id})">🛒 Abrir Caixa</button>
              <button type="button" class="btn-secondary" onclick="promptUpdateAttendance(${ev.id})">👥 Presentes (${ev.attendance_count})</button>
              <button type="button" class="btn-warning" onclick="setEventStatus(${ev.id}, 'encerrado', false)">⏹ Encerrar Evento</button>
            `;
          } else {
            actionsHtml = `
              <button type="button" class="btn-secondary" onclick="selectEventAndOpenCash(${ev.id})">👁 Ver Caixa / Pendências</button>
              <button type="button" class="btn-secondary" onclick="promptUpdateAttendance(${ev.id})">👥 Presentes (${ev.attendance_count})</button>
              <button type="button" class="btn-edit" onclick="setEventStatus(${ev.id}, 'aberto', true)">🔄 Reabrir Vendas</button>
            `;
          }

          const itemDiv = document.createElement('div');
          itemDiv.className = `event-item ${ev.status === 'aberto' ? 'active-event' : ''}`;
          itemDiv.innerHTML = `
            <div class="event-header">
              <div>
                <strong style="font-size:0.98rem;">${ev.name}</strong>
                <div style="font-size:0.78rem;color:var(--muted);">📅 Data: ${fmtDateBR(ev.event_date)} ${isSelected ? ' • (Selecionado no Caixa)' : ''}</div>
              </div>
              <span class="tag tag-${ev.status}">${statusLabel}</span>
            </div>
            <div class="event-metrics-grid">
              <div class="event-metric-box">
                <small>Jovens Presentes</small>
                <strong>${ev.attendance_count || 0}</strong>
              </div>
              <div class="event-metric-box">
                <small>Compraram (Únicos)</small>
                <strong>${ev.unique_buyers_count || 0}</strong>
              </div>
              <div class="event-metric-box">
                <small>% de Adesão</small>
                <strong class="text-primary">${adherenceText}</strong>
              </div>
              <div class="event-metric-box">
                <small>Ticket Médio</small>
                <strong>${fmtBRL(ev.avg_ticket)}</strong>
              </div>
            </div>
            <div class="progress-bar">
              <div class="progress-fill" style="width: ${pctWidth}%;"></div>
            </div>
            <div style="display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap;gap:0.5rem;">
              <div style="font-size:0.78rem;color:var(--muted);">
                Pago: <strong class="text-success">${fmtBRL(ev.total_paid)}</strong> &nbsp;|&nbsp;
                Pendente: <strong class="text-warning">${fmtBRL(ev.total_pending)}</strong>
              </div>
              <div class="event-actions">${actionsHtml}</div>
            </div>
          `;
          evListEl.appendChild(itemDiv);
        });
      }

      const evSelect = document.getElementById('active-event-select');
      evSelect.innerHTML = '';
      cachedEvents.forEach((ev) => {
        const opt = document.createElement('option');
        opt.value = String(ev.id);
        const st = ev.status === 'aberto' ? '🟢' : ev.status === 'agendado' ? '🟡' : '⚪';
        opt.textContent = `${st} ${ev.name} (${fmtDateBR(ev.event_date)})`;
        evSelect.appendChild(opt);
      });
      const allOpt = document.createElement('option');
      allOpt.value = 'all';
      allOpt.textContent = '📊 Todos os Eventos (Geral)';
      evSelect.appendChild(allOpt);
      evSelect.value = String(selectedEventId);

      const activeEv = cachedEvents.find((e) => String(e.id) === String(selectedEventId));
      const badgeEl = document.getElementById('active-event-badge');
      const closedNotice = document.getElementById('closed-order-notice');
      const submitBtn = document.getElementById('order-submit-btn');

      if (activeEv) {
        const stLabel = activeEv.status === 'aberto' ? 'Em Andamento' : activeEv.status === 'agendado' ? 'Agendado' : 'Encerrado';
        badgeEl.className = `tag tag-${activeEv.status}`;
        badgeEl.textContent = stLabel;
        document.getElementById('banner-attendance').textContent = String(activeEv.attendance_count || 0);
        document.getElementById('banner-buyers').textContent = String(activeEv.unique_buyers_count || 0);
        document.getElementById('banner-adherence').textContent =
          activeEv.adherence_rate !== null ? `${activeEv.adherence_rate}%` : 'Definir presentes';

        if (activeEv.status !== 'aberto') {
          closedNotice.style.display = 'block';
          submitBtn.disabled = true;
          submitBtn.style.opacity = '0.5';
        } else {
          closedNotice.style.display = 'none';
          submitBtn.disabled = false;
          submitBtn.style.opacity = '1';
        }
      } else {
        badgeEl.className = 'tag tag-aberto';
        badgeEl.textContent = 'Visão Geral';
        closedNotice.style.display = 'none';
        submitBtn.disabled = false;
        submitBtn.style.opacity = '1';
      }

      const closeRes = await fetch(`/cash-closing?event_id=${encodeURIComponent(selectedEventId)}`);
      const closing = await closeRes.json();

      const otherAlertEl = document.getElementById('other-pending-alert');
      if (closing.other_events_pending_count > 0) {
        document.getElementById('other-pending-text').textContent =
          `⚠ Há ${closing.other_events_pending_count} pedido(s) pendente(s) de outros eventos (${fmtBRL(closing.other_events_pending_total)}).`;
        otherAlertEl.style.display = 'flex';
      } else {
        otherAlertEl.style.display = 'none';
      }

      const catSelect = document.getElementById('prod-category');
      const catPills = document.getElementById('categories-pills');
      const currentCatVal = catSelect.value;
      catSelect.innerHTML = '';
      catPills.innerHTML = '';

      (categories || []).forEach((c) => {
        const opt = document.createElement('option');
        opt.value = c.id;
        opt.textContent = c.name;
        catSelect.appendChild(opt);

        const pill = document.createElement('span');
        pill.className = 'cat-pill';
        pill.textContent = c.name;
        catPills.appendChild(pill);
      });
      if (currentCatVal) catSelect.value = currentCatVal;

      const select = document.getElementById('order-product');
      const prodTbody = document.getElementById('products-tbody');
      select.innerHTML = '';
      prodTbody.innerHTML = '';

      cachedProducts.forEach((p) => {
        const stockLabel =
          p.stock_quantity === null || p.stock_quantity === undefined
            ? '<span style="color:var(--muted)">Livre</span>'
            : `<strong>${p.stock_quantity} un.</strong>`;
        const opt = document.createElement('option');
        opt.value = p.id;
        opt.textContent = `${p.name} — ${fmtBRL(p.price)}${p.stock_quantity !== null ? ` (Est: ${p.stock_quantity})` : ''}`;
        select.appendChild(opt);

        const tr = document.createElement('tr');
        tr.innerHTML = `
          <td><strong>${p.name}</strong></td>
          <td>${p.category_name || '-'}</td>
          <td>${fmtBRL(p.price)}</td>
          <td>${stockLabel}</td>
          <td><button type="button" class="btn-edit" onclick="startEditProduct(${p.id})">Editar</button></td>
        `;
        prodTbody.appendChild(tr);
      });

      document.getElementById('stat-paid').textContent = fmtBRL(closing.total_paid);
      document.getElementById('stat-paid-count').textContent = `${closing.paid_count || 0} pedido(s) pago(s)`;
      document.getElementById('stat-pending').textContent = fmtBRL(closing.total_pending);
      document.getElementById('stat-pending-count').textContent = `${closing.pending_count || 0} pedido(s) pendente(s)`;

      const methodsEntries = Object.entries(closing.by_payment_method || {});
      document.getElementById('stat-methods').innerHTML = methodsEntries.length
        ? methodsEntries.map(([m, val]) => `<strong>${m.toUpperCase()}:</strong> ${fmtBRL(val)}`).join(' &nbsp;|&nbsp; ')
        : 'Nenhum pagamento confirmado neste filtro';

      const pendingTbody = document.getElementById('pending-tbody');
      pendingTbody.innerHTML = '';
      if (!closing.pending_orders || closing.pending_orders.length === 0) {
        pendingTbody.innerHTML = '<tr><td colspan="5" style="color:var(--muted);text-align:center;padding:1rem;">Nenhum pedido pendente!</td></tr>';
      } else {
        closing.pending_orders.forEach((o) => {
          const tr = document.createElement('tr');
          tr.innerHTML = `
            <td>#${o.id}</td>
            <td><strong>${o.customer_name}</strong></td>
            <td>${(o.payment_method || '').toUpperCase()}</td>
            <td class="text-warning"><strong>${fmtBRL(o.total_amount)}</strong></td>
            <td><button class="btn-success" onclick="payOrder(${o.id})" style="padding:0.28rem 0.58rem;font-size:0.76rem;">Dar Baixa</button></td>
          `;
          pendingTbody.appendChild(tr);
        });
      }

      const filteredOrders =
        selectedEventId === 'all'
          ? allOrders
          : (allOrders || []).filter((o) => String(o.event_id || 1) === String(selectedEventId));

      const ordersTbody = document.getElementById('orders-tbody');
      ordersTbody.innerHTML = '';
      if (filteredOrders.length === 0) {
        ordersTbody.innerHTML = '<tr><td colspan="5" style="color:var(--muted);text-align:center;padding:1rem;">Nenhum pedido registrado neste evento ainda.</td></tr>';
      } else {
        filteredOrders.slice(0, 12).forEach((o) => {
          const itemsDesc = (o.order_items || [])
            .map((i) => `${i.quantity}x ${i.products ? i.products.name : 'Item'}`)
            .join(', ');
          const badgeClass = o.payment_status === 'pago' ? 'tag-pago' : 'tag-pendente';
          const tr = document.createElement('tr');
          tr.innerHTML = `
            <td>#${o.id}</td>
            <td>${o.customer_name}</td>
            <td style="font-size:0.76rem;color:var(--muted);">${itemsDesc || '-'}</td>
            <td>${fmtBRL(o.total_amount)}</td>
            <td><span class="tag ${badgeClass}">${o.payment_status}</span></td>
          `;
          ordersTbody.appendChild(tr);
        });
      }
      renderOrderCart();
    }

    async function payOrder(id) {
      const res = await fetch(`/orders/${id}/pay`, { method: 'PATCH', headers: { 'Content-Type': 'application/json' } });
      if (res.ok) {
        showToast(`Pedido #${id} marcado como PAGO!`);
        loadDashboard();
      } else {
        const err = await res.json();
        showToast(err.error || 'Erro ao dar baixa');
      }
    }

    document.getElementById('event-form').addEventListener('submit', async (e) => {
      e.preventDefault();
      const name = document.getElementById('ev-name').value.trim();
      const event_date = document.getElementById('ev-date').value;
      const attRaw = document.getElementById('ev-attendance').value.trim();
      const status = document.getElementById('ev-status').value;

      const res = await fetch('/events', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          name,
          event_date,
          attendance_count: attRaw === '' ? 0 : Number(attRaw),
          status
        })
      });
      const data = await res.json();
      if (res.ok) {
        document.getElementById('ev-name').value = '';
        document.getElementById('ev-attendance').value = '';
        selectedEventId = String(data.id);
        localStorage.setItem('csj_selected_event_id', selectedEventId);
        showToast(`Evento "${data.name}" criado!`);
        await loadDashboard();
        if (status === 'aberto') switchScreen('orders');
      } else {
        showToast(data.error || 'Erro ao criar evento');
      }
    });

    document.getElementById('order-product').addEventListener('change', renderOrderCart);
    document.getElementById('order-qty').addEventListener('input', renderOrderCart);

    document.getElementById('order-form').addEventListener('submit', async (e) => {
      e.preventDefault();
      const targetEvId = selectedEventId === 'all' ? (cachedEvents[0] ? cachedEvents[0].id : null) : Number(selectedEventId);
      const itemsToSend =
        orderCart.length > 0
          ? orderCart.map((i) => ({ product_id: Number(i.product_id), quantity: Number(i.quantity) }))
          : [
              {
                product_id: Number(document.getElementById('order-product').value),
                quantity: Math.max(1, Number(document.getElementById('order-qty').value || 1))
              }
            ];
      const payload = {
        event_id: targetEvId,
        customer_name: document.getElementById('order-customer').value,
        payment_method: document.getElementById('order-method').value,
        payment_status: document.getElementById('order-status').value,
        items: itemsToSend
      };
      const res = await fetch('/orders', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(payload)
      });
      const data = await res.json();
      if (res.ok) {
        document.getElementById('order-customer').value = '';
        document.getElementById('order-qty').value = '1';
        orderCart = [];
        renderOrderCart();
        showToast(`Pedido #${data.id} registrado (${fmtBRL(data.total_amount)})!`);
        loadDashboard();
      } else {
        showToast(data.error || 'Erro ao registrar pedido');
      }
    });

    document.getElementById('product-form').addEventListener('submit', async (e) => {
      e.preventDefault();
      const editId = document.getElementById('prod-edit-id').value;
      const stockRaw = document.getElementById('prod-stock').value.trim();
      const payload = {
        name: document.getElementById('prod-name').value.trim(),
        category_id: Number(document.getElementById('prod-category').value),
        price: Number(document.getElementById('prod-price').value),
        stock_quantity: stockRaw === '' ? null : Number(stockRaw)
      };

      const url = editId ? `/products/${editId}` : '/products';
      const method = editId ? 'PUT' : 'POST';

      const res = await fetch(url, {
        method,
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(payload)
      });
      const data = await res.json();
      if (res.ok) {
        if (editId) {
          showToast(`Produto "${data.name}" atualizado com sucesso!`);
          cancelEditProduct();
        } else {
          document.getElementById('prod-name').value = '';
          document.getElementById('prod-price').value = '';
          document.getElementById('prod-stock').value = '';
          showToast(`Produto "${data.name}" cadastrado com sucesso!`);
        }
        loadDashboard();
      } else {
        showToast(data.error || 'Erro ao salvar produto');
      }
    });

    document.getElementById('category-form').addEventListener('submit', async (e) => {
      e.preventDefault();
      const name = document.getElementById('cat-name').value.trim();
      if (!name) return;
      const res = await fetch('/categories', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ name })
      });
      const data = await res.json();
      if (res.ok) {
        document.getElementById('cat-name').value = '';
        showToast(`Categoria "${data.name}" criada!`);
        loadDashboard();
      } else {
        showToast(data.error || 'Erro ao criar categoria');
      }
    });

    loadDashboard();
  </script>
</body>
</html>
