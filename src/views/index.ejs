  <div id="toast"></div>

  <script>
    const SCHEMA_NAME = '<%= schema %>';
    const STORAGE_KEY = 'csj_db_v1';
    const EVENTS_BRIDGE_KEY = 'csj_events_bridge_v1';
    const TEST_STORAGE_KEY = 'csj_test_sandbox_v1';
    const ENV_STORAGE_KEY = 'csj_app_env';
    let currentEnv = localStorage.getItem(ENV_STORAGE_KEY) || 'production';

    const DEFAULT_SUPABASE_URL = 'https://irlxktcyucvckejrxunk.supabase.co';
    const DEFAULT_SUPABASE_KEY = 'eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6ImlybHhrdGN5dWN2Y2tlanJ4dW5rIiwicm9sZSI6ImFub24iLCJpYXQiOjE3NTgxNTMzNTcsImV4cCI6MjA3MzcyOTM1N30.9JqCS8cN_Lzrc1BYGYmVIpF9JPyLNUmxD0hKoNhStVA';

    const fmtBRL = (v) => Number(v || 0).toLocaleString('pt-BR', { style: 'currency', currency: 'BRL' });

    function fmtDateBR(isoDate) {
      if (!isoDate) return '-';
      const parts = String(isoDate).slice(0, 10).split('-');
      if (parts.length !== 3) return isoDate;
      return `${parts[2]}/${parts[1]}/${parts[0]}`;
    }

    function normalizeCustomerKey(name) {
      return String(name || '')
        .trim()
        .toLowerCase()
        .normalize('NFD')
        .replace(/[\u0300-\u036f]/g, '')
        .replace(/\s+/g, ' ');
    }

    let cachedProducts = [];
    let cachedCategories = [];
    let cachedEvents = [];
    let orderCart = [];
    let selectedEventId = localStorage.getItem('csj_selected_event_id') || '';

    function renderOrderCart() {
      const itemsContainer = document.getElementById('order-cart-items');
      const countEl = document.getElementById('order-cart-count');
      const totalEl = document.getElementById('order-cart-total');
      if (!itemsContainer) return;

      itemsContainer.innerHTML = '';

      if (orderCart.length === 0) {
        // Se o carrinho estiver vazio, mostra a prévia do item selecionado no select para compra rápida
        const selEl = document.getElementById('order-product');
        const qtyEl = document.getElementById('order-qty');
        const selProd = cachedProducts.find((p) => Number(p.id) === Number(selEl && selEl.value));
        const previewQty = Math.max(1, Number((qtyEl && qtyEl.value) || 1));
        const previewTotal = selProd ? selProd.price * previewQty : 0;

        itemsContainer.innerHTML = `<div style="color:var(--muted);font-size:0.78rem;text-align:center;padding:0.2rem 0;">Toque em <strong>+ Incluir</strong> para adicionar vários produtos, ou finalize direto com o produto selecionado acima.</div>`;
        countEl.textContent = selProd ? `1 item selecionado (${previewQty}x ${selProd.name})` : '0 itens';
        totalEl.textContent = fmtBRL(previewTotal);
        return;
      }

      let totalAmount = 0;
      let totalUnits = 0;

      orderCart.forEach((item, idx) => {
        const subtotal = item.price * item.quantity;
        totalAmount += subtotal;
        totalUnits += item.quantity;

        const row = document.createElement('div');
        row.className = 'cart-item-row';
        row.innerHTML = `
          <div style="flex:1;">
            <strong>${item.quantity}x ${item.name}</strong>
            <div style="font-size:0.74rem;color:var(--muted);">${fmtBRL(item.price)} un. = <strong style="color:var(--text);">${fmtBRL(subtotal)}</strong></div>
          </div>
          <div class="cart-item-controls">
            <button type="button" class="cart-qty-btn" onclick="changeCartItemQty(${idx}, -1)">-</button>
            <button type="button" class="cart-qty-btn" onclick="changeCartItemQty(${idx}, 1)">+</button>
            <button type="button" class="cart-remove-btn" onclick="removeCartItem(${idx})">✕</button>
          </div>
        `;
        itemsContainer.appendChild(row);
      });

      countEl.textContent = `${orderCart.length} produto(s) (${totalUnits} un.)`;
      totalEl.textContent = fmtBRL(totalAmount);
    }

    function addItemToOrderCart() {
      const prodSelect = document.getElementById('order-product');
      const qtyInput = document.getElementById('order-qty');
      const prodId = Number(prodSelect.value);
      const qty = Number(qtyInput.value);

      if (!prodId || !Number.isInteger(qty) || qty <= 0) {
        showToast('Selecione um produto e uma quantidade válida.');
        return;
      }

      const prod = cachedProducts.find((p) => Number(p.id) === prodId);
      if (!prod) return;

      const existing = orderCart.find((i) => Number(i.product_id) === prodId);
      const newTotalQty = (existing ? existing.quantity : 0) + qty;

      if (prod.stock_quantity !== null && prod.stock_quantity !== undefined && newTotalQty > prod.stock_quantity) {
        showToast(`Estoque insuficiente para "${prod.name}". Disponível: ${prod.stock_quantity} un.`);
        return;
      }

      if (existing) {
        existing.quantity = newTotalQty;
      } else {
        orderCart.push({
          product_id: prod.id,
          name: prod.name,
          price: Number(prod.price),
          stock_quantity: prod.stock_quantity,
          quantity: qty
        });
      }

      qtyInput.value = '1';
      renderOrderCart();
    }

    function changeCartItemQty(index, delta) {
      const item = orderCart[index];
      if (!item) return;
      const nextQty = item.quantity + delta;
      if (nextQty <= 0) {
        orderCart.splice(index, 1);
      } else {
        if (item.stock_quantity !== null && item.stock_quantity !== undefined && nextQty > item.stock_quantity) {
          showToast(`Estoque máximo disponível para "${item.name}": ${item.stock_quantity} un.`);
          return;
        }
        item.quantity = nextQty;
      }
      renderOrderCart();
    }

    function removeCartItem(index) {
      orderCart.splice(index, 1);
      renderOrderCart();
    }

    // Preenche a data de hoje por padrão no formulário de evento
    document.getElementById('ev-date').value = new Date().toISOString().slice(0, 10);

    function switchScreen(screenName) {
      ['events', 'orders', 'products'].forEach((s) => {
        document.getElementById(`screen-${s}`).classList.toggle('active', s === screenName);
        document.getElementById(`tab-${s}`).classList.toggle('active', s === screenName);
      });
    }

    function showToast(msg) {
      const el = document.getElementById('toast');
      el.textContent = msg;
      el.style.display = 'block';
      setTimeout(() => { el.style.display = 'none'; }, 3200);
    }

    function getDefaultSeed() {
      const today = new Date().toISOString().slice(0, 10);
      return {
        categories: [
          { id: 1, name: 'Lanches' },
          { id: 2, name: 'Bebidas' },
          { id: 3, name: 'Doces' }
        ],
        products: [
          { id: 1, name: 'Cachorro-Quente Completo', category_id: 1, price: 12.00, stock_quantity: null },
          { id: 2, name: 'Pastel de Carne', category_id: 1, price: 10.00, stock_quantity: null },
          { id: 3, name: 'Refrigerante Lata 350ml', category_id: 2, price: 6.00, stock_quantity: 48 },
          { id: 4, name: 'Brigadeiro Gourmet', category_id: 3, price: 4.50, stock_quantity: 30 }
        ],
        events: [
          { id: 1, name: 'Social de Jovens', event_date: today, status: 'aberto', attendance_count: 35 }
        ],
        orders: [],
        order_items: []
      };
    }

    function loadLocalDb() {
      try {
        const raw = localStorage.getItem(STORAGE_KEY);
        if (raw) {
          const parsed = JSON.parse(raw);
          if (!parsed.events) {
            parsed.events = [{ id: 1, name: 'Social de Jovens', event_date: new Date().toISOString().slice(0, 10), status: 'aberto', attendance_count: 35 }];
          }
          return parsed;
        }
      } catch (_) {}
      const seed = getDefaultSeed();
      saveLocalDb(seed);
      return seed;
    }

    function saveLocalDb(db) {
      localStorage.setItem(STORAGE_KEY, JSON.stringify(db));
    }

    function onOrderStatusChange() {
      const statusEl = document.getElementById('order-status');
      const boxEl = document.getElementById('partial-entry-box');
      if (!statusEl || !boxEl) return;
      boxEl.style.display = statusEl.value === 'parcial' ? 'block' : 'none';
    }

    // Bridge local para Eventos e Pagamentos Parciais caso a coluna paid_amount ainda não tenha sido criada no Supabase SQL Editor
    function loadEventsBridge() {
      try {
        const raw = localStorage.getItem(EVENTS_BRIDGE_KEY);
        if (raw) {
          const parsed = JSON.parse(raw);
          if (!parsed.paidAmountsMap) parsed.paidAmountsMap = {};
          return parsed;
        }
      } catch (_) {}
      const initial = {
        events: [
          { id: 1, name: 'Social de Jovens', event_date: new Date().toISOString().slice(0, 10), status: 'aberto', attendance_count: 30 }
        ],
        orderEventMap: {},
        paidAmountsMap: {}
      };
      localStorage.setItem(EVENTS_BRIDGE_KEY, JSON.stringify(initial));
      return initial;
    }

    function saveEventsBridge(bridge) {
      localStorage.setItem(EVENTS_BRIDGE_KEY, JSON.stringify(bridge));
    }

    function enrichOrderFinancials(order, bridgePaidMap = {}) {
      const total = Number(Number(order.total_amount || 0).toFixed(2));
      const isPaid = String(order.payment_status || '').toLowerCase() === 'pago';
      const rawPaid = isPaid
        ? total
        : order.paid_amount !== undefined && order.paid_amount !== null
        ? Number(order.paid_amount)
        : Number(bridgePaidMap[order.id] || 0);
      const paid = Number(Math.min(total, Math.max(0, rawPaid)).toFixed(2));
      const remaining = Number(Math.max(0, total - paid).toFixed(2));
      return {
        ...order,
        total_amount: total,
        paid_amount: paid,
        remaining_amount: remaining,
        is_partial: paid > 0 && remaining > 0
      };
    }

    function computeEventMetrics(ev, evOrders) {
      const uniqueMap = new Map();
      let totalPaid = 0;
      let totalPending = 0;
      for (const o of evOrders) {
        const k = normalizeCustomerKey(o.customer_name);
        if (k && !uniqueMap.has(k)) uniqueMap.set(k, String(o.customer_name).trim());
        const fin = enrichOrderFinancials(o);
        totalPaid += fin.paid_amount;
        totalPending += fin.remaining_amount;
      }
      const uniqueBuyersCount = uniqueMap.size;
      const attendanceCount = Number(ev.attendance_count || 0);
      const totalSales = Number((totalPaid + totalPending).toFixed(2));
      const adherenceRate = attendanceCount > 0 ? Number(((uniqueBuyersCount / attendanceCount) * 100).toFixed(1)) : null;
      const avgTicket = uniqueBuyersCount > 0 ? Number((totalSales / uniqueBuyersCount).toFixed(2)) : 0;
      return {
        ...ev,
        attendance_count: attendanceCount,
        unique_buyers_count: uniqueBuyersCount,
        unique_buyers: Array.from(uniqueMap.values()),
        adherence_rate: adherenceRate,
        avg_ticket: avgTicket,
        orders_count: evOrders.length,
        total_sales: totalSales,
        total_paid: Number(totalPaid.toFixed(2)),
        total_pending: Number(totalPending.toFixed(2))
      };
    }

    function isTestEnv() {
      return currentEnv === 'test';
    }

    function loadTestDb() {
      try {
        const raw = localStorage.getItem(TEST_STORAGE_KEY);
        if (raw) return JSON.parse(raw);
      } catch (_) {}
      return null;
    }

    function saveTestDb(db) {
      localStorage.setItem(TEST_STORAGE_KEY, JSON.stringify(db));
    }

    function initTestDbFromProduction(prodCategories = [], prodProducts = []) {
      const cats = (prodCategories && prodCategories.length > 0)
        ? JSON.parse(JSON.stringify(prodCategories))
        : getDefaultSeed().categories;
      const prods = (prodProducts && prodProducts.length > 0)
        ? JSON.parse(JSON.stringify(prodProducts))
        : getDefaultSeed().products;
      const today = new Date().toISOString().slice(0, 10);
      const testDb = {
        categories: cats,
        products: prods,
        events: [
          { id: 1, name: 'Social de Teste', event_date: today, status: 'aberto', attendance_count: 25 }
        ],
        orders: [],
        order_items: []
      };
      saveTestDb(testDb);
      return testDb;
    }

    function updateEnvUi() {
      const banner = document.getElementById('test-mode-banner');
      const envBtn = document.getElementById('btn-env-toggle');
      const envBadge = document.getElementById('brand-env-badge');
      if (isTestEnv()) {
        if (banner) banner.style.display = 'block';
        if (envBtn) {
          envBtn.textContent = '🟢 Ir p/ Produção';
          envBtn.style.color = '#34d399';
        }
        if (envBadge) {
          envBadge.textContent = 'TESTE';
          envBadge.className = 'env-pill env-pill-test';
        }
      } else {
        if (banner) banner.style.display = 'none';
        if (envBtn) {
          envBtn.textContent = '🧪 Modo Teste';
          envBtn.style.color = '#fbbf24';
        }
        if (envBadge) {
          envBadge.textContent = 'PROD';
          envBadge.className = 'env-pill env-pill-prod';
        }
      }
    }

    async function setAppEnvironment(target) {
      if (target === 'test') {
        let testDb = loadTestDb();
        if (!testDb) {
          initTestDbFromProduction(cachedCategories, cachedProducts);
        }
        currentEnv = 'test';
        localStorage.setItem(ENV_STORAGE_KEY, 'test');
        orderCart = [];
        selectedEventId = '1';
        localStorage.setItem('csj_selected_event_id', '1');
        showToast('🧪 Modo Teste ATIVADO! Seus testes não alteram o banco real.');
      } else {
        currentEnv = 'production';
        localStorage.setItem(ENV_STORAGE_KEY, 'production');
        orderCart = [];
        selectedEventId = localStorage.getItem('csj_selected_event_id') || '';
        showToast('🟢 Modo Produção ATIVADO! Conectado aos dados oficiais.');
      }
      updateEnvUi();
      await loadDashboard();
    }

    function toggleAppEnvironment() {
      setAppEnvironment(currentEnv === 'test' ? 'production' : 'test');
    }

    async function resetTestDatabase() {
      if (!window.confirm('Deseja realmente limpar todos os pedidos e eventos de teste? Os produtos de produção serão mantidos para novos testes.')) {
        return;
      }
      let prodCats = cachedCategories;
      let prodProds = cachedProducts;
      try {
        if (sbClient && backendMode === 'supabase') {
          const [{ data: cData }, { data: pData }] = await Promise.all([
            sbClient.from('categories').select('*').order('id'),
            sbClient.from('products').select('*').order('id')
          ]);
          if (cData && cData.length) prodCats = cData;
          if (pData && pData.length) prodProds = pData.map((p) => ({ ...p, price: Number(p.price) }));
        }
      } catch (_) {}

      initTestDbFromProduction(prodCats, prodProds);
      orderCart = [];
      selectedEventId = '1';
      localStorage.setItem('csj_selected_event_id', '1');
      showToast('Ambiente de testes resetado com sucesso!');
      await loadDashboard();
    }

    let backendMode = null;
    let sbClient = null;
    let supabaseHasEventsTable = null;

    function initSupabaseClient() {
      try {
        if (DEFAULT_SUPABASE_URL && DEFAULT_SUPABASE_KEY && window.supabase) {
          sbClient = window.supabase.createClient(DEFAULT_SUPABASE_URL, DEFAULT_SUPABASE_KEY, {
            db: { schema: SCHEMA_NAME }
          });
          return true;
        }
      } catch (_) {}
      return false;
    }

    async function detectBackend() {
      if (backendMode) return backendMode;
      try {
        const res = await fetch('/health', { method: 'GET' });
        if (res.ok) {
          const data = await res.json();
          if (data && data.schema === SCHEMA_NAME) {
            backendMode = 'express';
            return backendMode;
          }
        }
      } catch (_) {}

      if (initSupabaseClient()) {
        try {
          const { error } = await sbClient.from('categories').select('id').limit(1);
          if (!error) {
            backendMode = 'supabase';
            const evCheck = await sbClient.from('events').select('id').limit(1);
            supabaseHasEventsTable = !evCheck.error;
            return backendMode;
          }
        } catch (_) {}
      }

      backendMode = 'local';
      return backendMode;
    }

    const DataService = {
      async getEvents(allOrders = null) {
        if (isTestEnv()) {
          const testDb = loadTestDb() || initTestDbFromProduction(cachedCategories, cachedProducts);
          const orders = allOrders || (await this.getOrders());
          return [...(testDb.events || [])]
            .sort((a, b) => b.id - a.id)
            .map((ev) => {
              const evOrders = orders.filter((o) => Number(o.event_id || 1) === Number(ev.id));
              return computeEventMetrics(ev, evOrders);
            });
        }
        const mode = await detectBackend();
        if (mode === 'express') {
          const r = await fetch('/events');
          if (r.ok) return r.json();
        }
        const orders = allOrders || (await this.getOrders());
        if (mode === 'supabase' && supabaseHasEventsTable) {
          const { data, error } = await sbClient.from('events').select('*').order('id', { ascending: false });
          if (!error && data) {
            return data.map((ev) => {
              const evOrders = orders.filter((o) => Number(o.event_id) === Number(ev.id));
              return computeEventMetrics(ev, evOrders);
            });
          }
        }
        if (mode === 'supabase') {
          const bridge = loadEventsBridge();
          return [...bridge.events]
            .sort((a, b) => b.id - a.id)
            .map((ev) => {
              const evOrders = orders.filter((o) => Number(bridge.orderEventMap[o.id] || o.event_id || 1) === Number(ev.id));
              return computeEventMetrics(ev, evOrders);
            });
        }
        const db = loadLocalDb();
        return [...(db.events || [])]
          .sort((a, b) => b.id - a.id)
          .map((ev) => {
            const evOrders = orders.filter((o) => Number(o.event_id || 1) === Number(ev.id));
