<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="theme-color" content="#0f172a" />
  <meta name="mobile-web-app-capable" content="yes" />
  <meta name="apple-mobile-web-app-capable" content="yes" />
  <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
  <meta name="apple-mobile-web-app-title" content="Social Jovens" />
  <link rel="manifest" href="./manifest.json?v=3" />
  <link rel="icon" type="image/png" sizes="192x192" href="./icon-192.png?v=3" />
  <link rel="apple-touch-icon" href="./icon-192.png?v=3" />
  <title>Controle Social Jovens</title>
  <style>
    :root {
      --bg: #0f172a;
      --surface: #1e293b;
      --surface-hover: #334155;
      --border: #334155;
      --text: #f8fafc;
      --muted: #94a3b8;
      --primary: #3b82f6;
      --primary-hover: #2563eb;
      --success: #10b981;
      --warning: #f59e0b;
      --danger: #ef4444;
    }
    * { box-sizing: border-box; margin: 0; padding: 0; }
    body {
      font-family: system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
      background-color: var(--bg);
      color: var(--text);
      line-height: 1.45;
      padding: 1.25rem;
      max-width: 1280px;
      margin: 0 auto;
    }
    header {
      display: flex;
      flex-wrap: wrap;
      justify-content: space-between;
      align-items: center;
      gap: 0.85rem;
      margin-bottom: 1.25rem;
      padding-bottom: 0.95rem;
      border-bottom: 1px solid var(--border);
    }
    .brand-box {
      display: flex;
      align-items: center;
      gap: 0.75rem;
    }
    .brand-logo {
      width: 44px;
      height: 44px;
      border-radius: 50%;
      object-fit: cover;
      border: 2px solid rgba(255, 255, 255, 0.15);
      flex-shrink: 0;
    }
    header h1 {
      font-size: 1.35rem;
      font-weight: 700;
      letter-spacing: -0.02em;
    }
    header p {
      color: var(--muted);
      font-size: 0.84rem;
    }
    .nav-tabs {
      display: flex;
      gap: 0.4rem;
      background: var(--surface);
      padding: 0.3rem;
      border-radius: 0.65rem;
      border: 1px solid var(--border);
    }
    .nav-tab {
      background: transparent;
      border: none;
      color: var(--muted);
      padding: 0.5rem 0.95rem;
      border-radius: 0.45rem;
      font-size: 0.88rem;
      font-weight: 600;
      cursor: pointer;
      transition: all 0.15s ease;
      white-space: nowrap;
    }
    .nav-tab:hover {
      color: var(--text);
      background: rgba(255, 255, 255, 0.04);
    }
    .nav-tab.active {
      background: var(--primary);
      color: #ffffff;
      box-shadow: 0 2px 8px rgba(59, 130, 246, 0.35);
    }
    .screen {
      display: none;
      animation: fadeIn 0.15s ease-out;
    }
    .screen.active {
      display: block;
    }
    @keyframes fadeIn {
      from { opacity: 0; transform: translateY(3px); }
      to { opacity: 1; transform: translateY(0); }
    }
    .stats-row {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 0.85rem;
      margin-bottom: 1.15rem;
    }
    .stat-card {
      background: var(--surface);
      border: 1px solid var(--border);
      border-radius: 0.7rem;
      padding: 0.9rem 1.1rem;
    }
    .stat-card span {
      font-size: 0.8rem;
      color: var(--muted);
      display: block;
    }
    .stat-card strong {
      display: block;
      font-size: 1.45rem;
      margin-top: 0.15rem;
      line-height: 1.2;
    }
    .stat-card small {
      font-size: 0.76rem;
      color: var(--muted);
    }
    .text-success { color: var(--success); }
    .text-warning { color: var(--warning); }
    .grid-2 {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(380px, 1fr));
      gap: 1.1rem;
      align-items: start;
    }
    .card {
      background: var(--surface);
      border: 1px solid var(--border);
      border-radius: 0.75rem;
      padding: 1.15rem;
    }
    .card h2 {
      font-size: 1.02rem;
      margin-bottom: 0.9rem;
      display: flex;
      justify-content: space-between;
      align-items: center;
      border-bottom: 1px solid var(--border);
      padding-bottom: 0.55rem;
    }
    form { display: flex; flex-direction: column; gap: 0.75rem; }
    label {
      font-size: 0.8rem;
      color: var(--muted);
      display: block;
      margin-bottom: 0.25rem;
      font-weight: 500;
    }
    input, select, button {
      padding: 0.58rem 0.75rem;
      border-radius: 0.5rem;
      border: 1px solid var(--border);
      background: var(--bg);
      color: var(--text);
      font-size: 0.9rem;
    }
    input:focus, select:focus {
      outline: none;
      border-color: var(--primary);
    }
    button.btn-primary {
      background: var(--primary);
      border-color: var(--primary);
      color: #fff;
      font-weight: 600;
      cursor: pointer;
      padding: 0.65rem 0.95rem;
      transition: background 0.15s;
    }
    button.btn-primary:hover { background: var(--primary-hover); }
    button.btn-secondary {
      background: var(--surface-hover);
      border-color: var(--border);
      color: var(--text);
      font-weight: 600;
      cursor: pointer;
      padding: 0.65rem 0.95rem;
    }
    button.btn-success {
      background: var(--success);
      border-color: var(--success);
      color: #fff;
      font-weight: 600;
      cursor: pointer;
    }
    button.btn-edit {
      background: rgba(59, 130, 246, 0.16);
      border: 1px solid rgba(59, 130, 246, 0.4);
      color: #60a5fa;
      font-weight: 600;
      padding: 0.28rem 0.6rem;
      font-size: 0.78rem;
      cursor: pointer;
    }
    .table-wrap {
      width: 100%;
      overflow-x: auto;
      -webkit-overflow-scrolling: touch;
    }
    table {
      width: 100%;
      border-collapse: collapse;
      font-size: 0.86rem;
      margin-top: 0.25rem;
    }
    th, td {
      text-align: left;
      padding: 0.55rem 0.4rem;
      border-bottom: 1px solid var(--border);
    }
    th {
      color: var(--muted);
      font-weight: 600;
      font-size: 0.76rem;
      text-transform: uppercase;
      letter-spacing: 0.03em;
    }
    .tag {
      display: inline-block;
      padding: 0.15rem 0.5rem;
      border-radius: 0.35rem;
      font-size: 0.72rem;
      font-weight: 600;
      text-transform: uppercase;
    }
    .tag-pago { background: rgba(16, 185, 129, 0.2); color: #34d399; }
    .tag-pendente { background: rgba(245, 158, 11, 0.2); color: #fbbf24; }
    .cat-pills {
      display: flex;
      flex-wrap: wrap;
      gap: 0.4rem;
      margin-top: 0.65rem;
    }
    .cat-pill {
      background: rgba(255, 255, 255, 0.06);
      border: 1px solid var(--border);
      padding: 0.2rem 0.6rem;
      border-radius: 999px;
      font-size: 0.78rem;
      color: var(--text);
    }
    #toast {
      position: fixed;
      bottom: 1rem;
      right: 1rem;
      left: 1rem;
      max-width: 420px;
      margin: 0 auto;
      background: #1e293b;
      border: 1px solid var(--primary);
      padding: 0.75rem 1rem;
      border-radius: 0.55rem;
      display: none;
      z-index: 100;
      box-shadow: 0 10px 25px rgba(0,0,0,0.5);
      text-align: center;
      font-size: 0.88rem;
    }

    @media (max-width: 768px) {
      body {
        padding: 0.65rem;
      }
      header {
        flex-direction: column;
        align-items: stretch;
        gap: 0.65rem;
        margin-bottom: 0.85rem;
        padding-bottom: 0.7rem;
      }
      .brand-logo {
        width: 38px;
        height: 38px;
      }
      header h1 {
        font-size: 1.15rem;
      }
      header p {
        font-size: 0.78rem;
      }
      .nav-tabs {
        width: 100%;
        justify-content: space-between;
      }
      .nav-tab {
        flex: 1;
        text-align: center;
        padding: 0.48rem 0.4rem;
        font-size: 0.8rem;
      }
      .stats-row {
        grid-template-columns: 1fr 1fr;
        gap: 0.55rem;
        margin-bottom: 0.85rem;
      }
      .stats-row .stat-card:nth-child(3) {
        grid-column: 1 / -1;
      }
      .stat-card {
        padding: 0.65rem 0.8rem;
        border-radius: 0.6rem;
      }
      .stat-card span {
        font-size: 0.74rem;
      }
      .stat-card strong {
        font-size: 1.18rem;
      }
      .grid-2 {
        grid-template-columns: 1fr;
        gap: 0.8rem;
      }
      .card {
        padding: 0.85rem;
        border-radius: 0.65rem;
      }
      .card h2 {
        font-size: 0.95rem;
        margin-bottom: 0.7rem;
        padding-bottom: 0.45rem;
      }
      input, select, button {
        padding: 0.5rem 0.65rem;
        font-size: 0.86rem;
      }
      th, td {
        padding: 0.45rem 0.3rem;
        font-size: 0.8rem;
      }
    }
  </style>
</head>
<body>
  <header>
    <div class="brand-box">
      <img src="./icon-192.png?v=3" alt="Detroit Jovens" class="brand-logo" />
      <div>
        <h1>Controle Social Jovens</h1>
        <p>Gestão de Pedidos, Caixa e Produtos</p>
      </div>
    </div>
    <nav class="nav-tabs" aria-label="Navegação Principal">
      <button type="button" class="nav-tab active" id="tab-orders" onclick="switchScreen('orders')">
        🛒 Registrar Pedido
      </button>
      <button type="button" class="nav-tab" id="tab-products" onclick="switchScreen('products')">
        📦 Produtos & Categorias
      </button>
      <button type="button" class="nav-tab" id="btn-install-pwa" onclick="installPwaApp()" style="display: none; color: #34d399;">
        📲 Instalar
      </button>
    </nav>
  </header>

  <!-- TELA 1: REGISTRAR PEDIDO, PENDÊNCIAS E RESUMO DO CAIXA -->
  <main id="screen-orders" class="screen active">
    <section class="stats-row">
      <div class="stat-card">
        <span>Total Recebido (Pagos)</span>
        <strong class="text-success" id="stat-paid">R$ 0,00</strong>
        <small id="stat-paid-count">0 pedido(s) pago(s)</small>
      </div>
      <div class="stat-card">
        <span>Total Pendente</span>
        <strong class="text-warning" id="stat-pending">R$ 0,00</strong>
        <small id="stat-pending-count">0 pedido(s) pendente(s)</small>
      </div>
      <div class="stat-card">
        <span>Recebido por Forma de Pagamento</span>
        <div id="stat-methods" style="font-size: 0.85rem; margin-top: 0.35rem; color: var(--text);">-</div>
      </div>
    </section>

    <div class="grid-2">
      <div class="card">
        <h2>Novo Pedido</h2>
        <form id="order-form">
          <div>
            <label for="order-customer">Nome do Cliente / Jovem</label>
            <input type="text" id="order-customer" placeholder="Ex: Lucas Mendes" required style="width: 100%;" />
          </div>
          <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 0.6rem;">
            <div>
              <label for="order-method">Forma de Pagamento</label>
              <select id="order-method" style="width: 100%;">
                <option value="pix">Pix</option>
                <option value="dinheiro">Dinheiro</option>
                <option value="cartao">Cartão</option>
              </select>
            </div>
            <div>
              <label for="order-status">Status do Pagamento</label>
              <select id="order-status" style="width: 100%;">
                <option value="pago">Pago na hora</option>
                <option value="pendente">Pendente</option>
              </select>
            </div>
          </div>
          <div style="display: grid; grid-template-columns: 2.2fr 1fr; gap: 0.6rem;">
            <div>
              <label for="order-product">Produto</label>
              <select id="order-product" style="width: 100%;"></select>
            </div>
            <div>
              <label for="order-qty">Qtd</label>
              <input type="number" id="order-qty" value="1" min="1" required style="width: 100%;" />
            </div>
          </div>
          <button type="submit" class="btn-primary">Finalizar Pedido</button>
        </form>

        <h2 style="margin-top: 1.35rem;">Últimos Pedidos Registrados</h2>
        <div class="table-wrap">
          <table>
            <thead>
              <tr>
                <th>#</th>
                <th>Cliente</th>
                <th>Itens</th>
                <th>Total</th>
                <th>Status</th>
              </tr>
            </thead>
            <tbody id="orders-tbody"></tbody>
          </table>
        </div>
      </div>

      <div class="card">
        <h2>Pedidos Pendentes — Dar Baixa</h2>
        <p style="font-size: 0.8rem; color: var(--muted); margin-bottom: 0.55rem;">
          Pedidos marcados como <strong>pendente</strong> ficam listados abaixo até o pagamento ser confirmado:
        </p>
        <div class="table-wrap">
          <table>
            <thead>
              <tr>
                <th>#</th>
                <th>Cliente</th>
                <th>Forma</th>
                <th>Valor</th>
                <th>Ação</th>
              </tr>
            </thead>
            <tbody id="pending-tbody"></tbody>
          </table>
        </div>
      </div>
    </div>
  </main>

  <!-- TELA 2: CADASTRO/EDIÇÃO DE PRODUTOS, CATEGORIAS E ESTOQUE -->
  <section id="screen-products" class="screen">
    <div class="grid-2">
      <div style="display: flex; flex-direction: column; gap: 1rem;">
        <div class="card">
          <h2 id="product-form-title">Cadastrar Novo Produto</h2>
          <form id="product-form">
            <input type="hidden" id="prod-edit-id" value="" />
            <div>
              <label for="prod-name">Nome do Produto</label>
              <input type="text" id="prod-name" placeholder="Ex: Refrigerante Lata 350ml" required style="width: 100%;" />
            </div>
            <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 0.6rem;">
              <div>
                <label for="prod-category">Categoria</label>
                <select id="prod-category" style="width: 100%;"></select>
              </div>
              <div>
                <label for="prod-price">Preço Unitário (R$)</label>
                <input type="number" id="prod-price" step="0.50" min="0" placeholder="Ex: 6.00" required style="width: 100%;" />
              </div>
            </div>
            <div>
              <label for="prod-stock">Estoque <span style="font-weight:400;">(Vazio = sem controle de estoque)</span></label>
              <input type="number" id="prod-stock" min="0" placeholder="Livre / Sem controle" style="width: 100%;" />
            </div>
            <div style="display: flex; gap: 0.5rem;">
              <button type="submit" class="btn-primary" id="prod-submit-btn" style="flex: 1;">Salvar Produto</button>
              <button type="button" class="btn-secondary" id="prod-cancel-btn" onclick="cancelEditProduct()" style="display: none;">Cancelar</button>
            </div>
          </form>
        </div>

        <div class="card">
          <h2>Categorias de Produtos</h2>
          <form id="category-form" style="flex-direction: row; gap: 0.5rem; align-items: end;">
            <div style="flex: 1;">
              <label for="cat-name">Nova Categoria</label>
              <input type="text" id="cat-name" placeholder="Ex: Salgados, Sobremesas..." required style="width: 100%;" />
            </div>
            <button type="submit" class="btn-primary" style="white-space: nowrap;">+ Criar</button>
          </form>
          <div class="cat-pills" id="categories-pills"></div>
        </div>
      </div>

      <div class="card">
        <h2>Produtos Cadastrados & Estoque</h2>
        <div class="table-wrap">
          <table>
            <thead>
              <tr>
                <th>Produto</th>
                <th>Categoria</th>
                <th>Preço</th>
                <th>Estoque</th>
                <th>Ação</th>
              </tr>
            </thead>
            <tbody id="products-tbody"></tbody>
          </table>
        </div>
      </div>
    </div>
  </section>

  <div id="toast"></div>

  <script>
    const SCHEMA_NAME = '<%= schema %>';
    const fmtBRL = (v) => Number(v || 0).toLocaleString('pt-BR', { style: 'currency', currency: 'BRL' });
    let cachedProducts = [];

    function switchScreen(screenName) {
      const isOrders = screenName === 'orders';
      document.getElementById('screen-orders').classList.toggle('active', isOrders);
      document.getElementById('screen-products').classList.toggle('active', !isOrders);
      document.getElementById('tab-orders').classList.toggle('active', isOrders);
      document.getElementById('tab-products').classList.toggle('active', !isOrders);
    }

    function showToast(msg) {
      const el = document.getElementById('toast');
      el.textContent = msg;
      el.style.display = 'block';
      setTimeout(() => { el.style.display = 'none'; }, 3200);
    }

    function startEditProduct(productId) {
      const prod = cachedProducts.find((p) => Number(p.id) === Number(productId));
      if (!prod) return;

      document.getElementById('prod-edit-id').value = prod.id;
      document.getElementById('prod-name').value = prod.name;
      document.getElementById('prod-category').value = prod.category_id;
      document.getElementById('prod-price').value = prod.price;
      document.getElementById('prod-stock').value =
        prod.stock_quantity === null || prod.stock_quantity === undefined ? '' : prod.stock_quantity;

      document.getElementById('product-form-title').textContent = `Editar Produto #${prod.id}`;
      document.getElementById('prod-submit-btn').textContent = 'Salvar Alterações';
      document.getElementById('prod-cancel-btn').style.display = 'inline-block';
      document.getElementById('prod-name').focus();
    }

    function cancelEditProduct() {
      document.getElementById('prod-edit-id').value = '';
      document.getElementById('prod-name').value = '';
      document.getElementById('prod-price').value = '';
      document.getElementById('prod-stock').value = '';
      document.getElementById('product-form-title').textContent = 'Cadastrar Novo Produto';
      document.getElementById('prod-submit-btn').textContent = 'Salvar Produto';
      document.getElementById('prod-cancel-btn').style.display = 'none';
    }

    async function loadDashboard() {
      const [catRes, prodRes, ordRes, closeRes] = await Promise.all([
        fetch('/categories'),
        fetch('/products'),
        fetch('/orders'),
        fetch('/cash-closing')
      ]);
      const categories = await catRes.json();
      const products = await prodRes.json();
      const orders = await ordRes.json();
      const closing = await closeRes.json();

      cachedProducts = products || [];

      const catSelect = document.getElementById('prod-category');
      const catPills = document.getElementById('categories-pills');
      const currentCatVal = catSelect.value;
      catSelect.innerHTML = '';
      catPills.innerHTML = '';

      (categories || []).forEach((c) => {
        const opt = document.createElement('option');
        opt.value = c.id;
        opt.textContent = c.name;
        catSelect.appendChild(opt);

        const pill = document.createElement('span');
        pill.className = 'cat-pill';
        pill.textContent = c.name;
        catPills.appendChild(pill);
      });
      if (currentCatVal) catSelect.value = currentCatVal;

      const select = document.getElementById('order-product');
      const prodTbody = document.getElementById('products-tbody');
      select.innerHTML = '';
      prodTbody.innerHTML = '';

      cachedProducts.forEach((p) => {
        const stockLabel =
          p.stock_quantity === null || p.stock_quantity === undefined
            ? '<span style="color:var(--muted)">Livre</span>'
            : `<strong>${p.stock_quantity} un.</strong>`;
        const opt = document.createElement('option');
        opt.value = p.id;
        opt.textContent = `${p.name} — ${fmtBRL(p.price)}${p.stock_quantity !== null ? ` (Est: ${p.stock_quantity})` : ''}`;
        select.appendChild(opt);

        const tr = document.createElement('tr');
        tr.innerHTML = `
          <td><strong>${p.name}</strong></td>
          <td>${p.category_name || '-'}</td>
          <td>${fmtBRL(p.price)}</td>
          <td>${stockLabel}</td>
          <td><button type="button" class="btn-edit" onclick="startEditProduct(${p.id})">Editar</button></td>
        `;
        prodTbody.appendChild(tr);
      });

      document.getElementById('stat-paid').textContent = fmtBRL(closing.total_paid);
      document.getElementById('stat-paid-count').textContent = `${closing.paid_count || 0} pedido(s) pago(s)`;
      document.getElementById('stat-pending').textContent = fmtBRL(closing.total_pending);
      document.getElementById('stat-pending-count').textContent = `${closing.pending_count || 0} pedido(s) pendente(s)`;

      const methodsEntries = Object.entries(closing.by_payment_method || {});
      document.getElementById('stat-methods').innerHTML = methodsEntries.length
        ? methodsEntries.map(([m, val]) => `<strong>${m.toUpperCase()}:</strong> ${fmtBRL(val)}`).join(' &nbsp;|&nbsp; ')
        : 'Nenhum pagamento confirmado ainda';

      const pendingTbody = document.getElementById('pending-tbody');
      pendingTbody.innerHTML = '';
      if (!closing.pending_orders || closing.pending_orders.length === 0) {
        pendingTbody.innerHTML = '<tr><td colspan="5" style="color:var(--muted);text-align:center;padding:1rem;">Nenhum pedido pendente!</td></tr>';
      } else {
        closing.pending_orders.forEach((o) => {
          const tr = document.createElement('tr');
          tr.innerHTML = `
            <td>#${o.id}</td>
            <td><strong>${o.customer_name}</strong></td>
            <td>${(o.payment_method || '').toUpperCase()}</td>
            <td class="text-warning"><strong>${fmtBRL(o.total_amount)}</strong></td>
            <td><button class="btn-success" onclick="payOrder(${o.id})" style="padding:0.3rem 0.6rem;font-size:0.78rem;">Dar Baixa</button></td>
          `;
          pendingTbody.appendChild(tr);
        });
      }

      const ordersTbody = document.getElementById('orders-tbody');
      ordersTbody.innerHTML = '';
      if (!orders || orders.length === 0) {
        ordersTbody.innerHTML = '<tr><td colspan="5" style="color:var(--muted);text-align:center;padding:1rem;">Nenhum pedido registrado ainda.</td></tr>';
      } else {
        orders.slice(0, 10).forEach((o) => {
          const itemsDesc = (o.order_items || [])
            .map((i) => `${i.quantity}x ${i.products ? i.products.name : 'Item'}`)
            .join(', ');
          const badgeClass = o.payment_status === 'pago' ? 'tag-pago' : 'tag-pendente';
          const tr = document.createElement('tr');
          tr.innerHTML = `
            <td>#${o.id}</td>
            <td>${o.customer_name}</td>
            <td style="font-size:0.78rem;color:var(--muted);">${itemsDesc || '-'}</td>
            <td>${fmtBRL(o.total_amount)}</td>
            <td><span class="tag ${badgeClass}">${o.payment_status}</span></td>
          `;
          ordersTbody.appendChild(tr);
        });
      }
    }

    async function payOrder(id) {
      const res = await fetch(`/orders/${id}/pay`, { method: 'PATCH', headers: { 'Content-Type': 'application/json' } });
      if (res.ok) {
        showToast(`Pedido #${id} marcado como PAGO!`);
        loadDashboard();
      } else {
        const err = await res.json();
        showToast(err.error || 'Erro ao dar baixa');
      }
    }

    document.getElementById('order-form').addEventListener('submit', async (e) => {
      e.preventDefault();
      const payload = {
        customer_name: document.getElementById('order-customer').value,
        payment_method: document.getElementById('order-method').value,
        payment_status: document.getElementById('order-status').value,
        items: [
          {
            product_id: Number(document.getElementById('order-product').value),
            quantity: Number(document.getElementById('order-qty').value)
          }
        ]
      };
      const res = await fetch('/orders', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(payload)
      });
      const data = await res.json();
      if (res.ok) {
        document.getElementById('order-customer').value = '';
        document.getElementById('order-qty').value = '1';
        showToast(`Pedido #${data.id} registrado (${fmtBRL(data.total_amount)})!`);
        loadDashboard();
      } else {
        showToast(data.error || 'Erro ao registrar pedido');
      }
    });

    document.getElementById('product-form').addEventListener('submit', async (e) => {
      e.preventDefault();
      const editId = document.getElementById('prod-edit-id').value;
      const stockRaw = document.getElementById('prod-stock').value.trim();
      const payload = {
        name: document.getElementById('prod-name').value.trim(),
        category_id: Number(document.getElementById('prod-category').value),
        price: Number(document.getElementById('prod-price').value),
        stock_quantity: stockRaw === '' ? null : Number(stockRaw)
      };

      const url = editId ? `/products/${editId}` : '/products';
      const method = editId ? 'PUT' : 'POST';

      const res = await fetch(url, {
        method,
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(payload)
      });
      const data = await res.json();
      if (res.ok) {
        if (editId) {
          showToast(`Produto "${data.name}" atualizado com sucesso!`);
          cancelEditProduct();
        } else {
          document.getElementById('prod-name').value = '';
          document.getElementById('prod-price').value = '';
          document.getElementById('prod-stock').value = '';
          showToast(`Produto "${data.name}" cadastrado com sucesso!`);
        }
        loadDashboard();
      } else {
        showToast(data.error || 'Erro ao salvar produto');
      }
    });

    document.getElementById('category-form').addEventListener('submit', async (e) => {
      e.preventDefault();
      const name = document.getElementById('cat-name').value.trim();
      if (!name) return;
      const res = await fetch('/categories', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ name })
      });
      const data = await res.json();
      if (res.ok) {
        document.getElementById('cat-name').value = '';
        showToast(`Categoria "${data.name}" criada!`);
        loadDashboard();
      } else {
        showToast(data.error || 'Erro ao criar categoria');
      }
    });

    loadDashboard();
  </script>
</body>
</html>
