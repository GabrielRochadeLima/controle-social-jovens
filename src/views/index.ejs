          return (data || []).map((p) => ({
            ...p,
            price: Number(p.price),
            category_name: p.categories ? p.categories.name : '-'
          }));
        }
        const db = loadLocalDb();
        return db.products.map((p) => {
          const cat = db.categories.find((c) => Number(c.id) === Number(p.category_id));
