      async createOrder({ customer_name, payment_method, payment_status, paid_amount, items, event_id }) {
        if (isTestEnv()) {
          const testDb = loadTestDb() || initTestDbFromProduction(cachedCategories, cachedProducts);
          let total = 0;
          for (const item of items) {
            const prod = (testDb.products || []).find((p) => Number(p.id) === Number(item.product_id));
            if (!prod) throw new Error('Produto não encontrado.');
            if (prod.stock_quantity !== null && prod.stock_quantity !== undefined && prod.stock_quantity < item.quantity) {
              throw new Error(`Estoque insuficiente para "${prod.name}". Disponível: ${prod.stock_quantity}`);
            }
            total += Number(prod.price) * Number(item.quantity);
          }

          const finalTotal = Number(total.toFixed(2));
          let finalPaidAmount = payment_status === 'pago' ? finalTotal : 0;
          if (paid_amount !== undefined && paid_amount !== null && paid_amount !== '') {
            finalPaidAmount = Number(Number(paid_amount).toFixed(2));
            if (Number.isNaN(finalPaidAmount) || finalPaidAmount < 0 || finalPaidAmount > finalTotal) {
              throw new Error(`O valor pago agora deve estar entre R$ 0,00 e ${fmtBRL(finalTotal)}.`);
            }
          }
          if (payment_status === 'parcial' && (finalPaidAmount <= 0 || finalPaidAmount >= finalTotal)) {
            throw new Error(`Para pagamento parcial, informe um valor maior que R$ 0,00 e menor que ${fmtBRL(finalTotal)}.`);
          }
          const dbPaymentStatus = finalPaidAmount >= finalTotal ? 'pago' : 'pendente';

          const nextOrderId = (testDb.orders || []).reduce((m, o) => Math.max(m, o.id), 0) + 1;
          const newOrder = {
            id: nextOrderId,
            event_id: event_id ? Number(event_id) : 1,
            customer_name,
            payment_method,
            payment_status: dbPaymentStatus,
            total_amount: finalTotal,
            paid_amount: finalPaidAmount,
            created_at: new Date().toISOString()
          };
          testDb.orders.push(newOrder);

          let nextItemId = (testDb.order_items || []).reduce((m, i) => Math.max(m, i.id), 0) + 1;
          for (const item of items) {
            const prod = (testDb.products || []).find((p) => Number(p.id) === Number(item.product_id));
            testDb.order_items.push({
              id: nextItemId++,
              order_id: nextOrderId,
              product_id: prod.id,
              quantity: Number(item.quantity),
              unit_price: Number(prod.price)
            });
            if (prod.stock_quantity !== null && prod.stock_quantity !== undefined) {
              prod.stock_quantity -= Number(item.quantity);
            }
          }
          saveTestDb(testDb);
          return enrichOrderFinancials(newOrder);
        }
        const mode = await detectBackend();
        if (mode === 'express') {
          const r = await fetch('/orders', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ customer_name, payment_method, payment_status, paid_amount, items, event_id })
          });
          const data = await r.json();
          if (!r.ok) throw new Error(data.error || 'Erro ao criar pedido');
          return enrichOrderFinancials(data);
        }
        if (mode === 'supabase') {
          const ids = items.map((i) => Number(i.product_id));
          const { data: prods, error: pErr } = await sbClient.from('products').select('*').in('id', ids);
          if (pErr) throw new Error(pErr.message);

          let total = 0;
          for (const item of items) {
            const prod = (prods || []).find((p) => Number(p.id) === Number(item.product_id));
            if (!prod) throw new Error('Produto não encontrado');
            if (prod.stock_quantity !== null && prod.stock_quantity < item.quantity) {
              throw new Error(`Estoque insuficiente para "${prod.name}" (Disponível: ${prod.stock_quantity})`);
            }
            total += Number(prod.price) * Number(item.quantity);
          }

          const finalTotal = Number(total.toFixed(2));
          let finalPaidAmount = payment_status === 'pago' ? finalTotal : 0;
          if (paid_amount !== undefined && paid_amount !== null && paid_amount !== '') {
            finalPaidAmount = Number(Number(paid_amount).toFixed(2));
            if (Number.isNaN(finalPaidAmount) || finalPaidAmount < 0 || finalPaidAmount > finalTotal) {
              throw new Error(`O valor pago agora deve estar entre R$ 0,00 e ${fmtBRL(finalTotal)}.`);
            }
          }
          if (payment_status === 'parcial' && (finalPaidAmount <= 0 || finalPaidAmount >= finalTotal)) {
            throw new Error(`Para pagamento parcial, informe um valor maior que R$ 0,00 e menor que ${fmtBRL(finalTotal)}.`);
          }
          const dbPaymentStatus = finalPaidAmount >= finalTotal ? 'pago' : 'pendente';

          const insertPayload = {
            customer_name,
            payment_method,
            payment_status: dbPaymentStatus,
            total_amount: finalTotal,
            paid_amount: finalPaidAmount
          };
          if (supabaseHasEventsTable && event_id) {
            insertPayload.event_id = Number(event_id);
          }

          let { data: ord, error: oErr } = await sbClient
            .from('orders')
            .insert([insertPayload])
            .select()
            .single();

          if (oErr && String(oErr.message || '').includes('paid_amount')) {
            delete insertPayload.paid_amount;
            const retry = await sbClient.from('orders').insert([insertPayload]).select().single();
            ord = retry.data;
            oErr = retry.error;
          }
          if (oErr) throw new Error(oErr.message);

          const bridge = loadEventsBridge();
          if (!supabaseHasEventsTable && event_id) {
            bridge.orderEventMap[ord.id] = Number(event_id);
          }
          if (finalPaidAmount > 0 && finalPaidAmount < finalTotal) {
            bridge.paidAmountsMap[ord.id] = finalPaidAmount;
          }
          saveEventsBridge(bridge);

          for (const item of items) {
            const prod = prods.find((p) => Number(p.id) === Number(item.product_id));
            await sbClient.from('order_items').insert([
              { order_id: ord.id, product_id: prod.id, quantity: item.quantity, unit_price: prod.price }
            ]);
            if (prod.stock_quantity !== null) {
              await sbClient
                .from('products')
                .update({ stock_quantity: prod.stock_quantity - item.quantity })
                .eq('id', prod.id);
            }
          }
          return enrichOrderFinancials(ord, bridge.paidAmountsMap);
        }

        const db = loadLocalDb();
        let total = 0;
        for (const item of items) {
          const prod = db.products.find((p) => Number(p.id) === Number(item.product_id));
          if (!prod) throw new Error('Produto não encontrado.');
          if (prod.stock_quantity !== null && prod.stock_quantity < item.quantity) {
            throw new Error(`Estoque insuficiente para "${prod.name}". Disponível: ${prod.stock_quantity}`);
          }
          total += Number(prod.price) * Number(item.quantity);
        }

        const finalTotal = Number(total.toFixed(2));
        let finalPaidAmount = payment_status === 'pago' ? finalTotal : 0;
        if (paid_amount !== undefined && paid_amount !== null && paid_amount !== '') {
          finalPaidAmount = Number(Number(paid_amount).toFixed(2));
        }
        const dbPaymentStatus = finalPaidAmount >= finalTotal ? 'pago' : 'pendente';

        const nextOrderId = db.orders.reduce((m, o) => Math.max(m, o.id), 0) + 1;
        const newOrder = {
          id: nextOrderId,
          event_id: event_id ? Number(event_id) : 1,
          customer_name,
          payment_method,
          payment_status: dbPaymentStatus,
          total_amount: finalTotal,
          paid_amount: finalPaidAmount,
          created_at: new Date().toISOString()
        };
        db.orders.push(newOrder);

        let nextItemId = db.order_items.reduce((m, i) => Math.max(m, i.id), 0) + 1;
        for (const item of items) {
          const prod = db.products.find((p) => Number(p.id) === Number(item.product_id));
          db.order_items.push({
            id: nextItemId++,
            order_id: nextOrderId,
            product_id: prod.id,
            quantity: Number(item.quantity),
            unit_price: Number(prod.price)
          });
          if (prod.stock_quantity !== null) {
            prod.stock_quantity -= Number(item.quantity);
          }
        }
        saveLocalDb(db);
        return enrichOrderFinancials(newOrder);
      },

      async payOrder(orderId, amount = null) {
        if (isTestEnv()) {
          const testDb = loadTestDb() || initTestDbFromProduction(cachedCategories, cachedProducts);
          const ord = (testDb.orders || []).find((o) => Number(o.id) === Number(orderId));
          if (!ord) throw new Error('Pedido de teste não encontrado');
          const fin = enrichOrderFinancials(ord);
          const addAmount = amount !== null ? Number(Number(amount).toFixed(2)) : fin.remaining_amount;
          if (Number.isNaN(addAmount) || addAmount <= 0 || addAmount > fin.remaining_amount + 0.001) {
            throw new Error(`Informe um valor válido entre R$ 0,01 e ${fmtBRL(fin.remaining_amount)}.`);
          }
          const newPaid = Number(Math.min(fin.total_amount, fin.paid_amount + addAmount).toFixed(2));
          ord.paid_amount = newPaid;
          ord.payment_status = newPaid >= fin.total_amount ? 'pago' : 'pendente';
          saveTestDb(testDb);
          return enrichOrderFinancials(ord);
        }
        const mode = await detectBackend();
        if (mode === 'express') {
          const r = await fetch(`/orders/${orderId}/pay`, {
            method: 'PATCH',
            headers: { 'Content-Type': 'application/json' },
            body: amount !== null ? JSON.stringify({ amount: Number(amount) }) : JSON.stringify({})
          });
          const data = await r.json();
          if (!r.ok) throw new Error(data.error || 'Erro ao dar baixa');
          return enrichOrderFinancials(data);
        }
        if (mode === 'supabase') {
          const { data: current, error: gErr } = await sbClient
            .from('orders')
            .select('*')
            .eq('id', Number(orderId))
            .single();
          if (gErr || !current) throw new Error((gErr && gErr.message) || 'Pedido não encontrado');

          const bridge = loadEventsBridge();
          const fin = enrichOrderFinancials(current, bridge.paidAmountsMap);
          const addAmount = amount !== null ? Number(Number(amount).toFixed(2)) : fin.remaining_amount;
          if (Number.isNaN(addAmount) || addAmount <= 0 || addAmount > fin.remaining_amount + 0.001) {
            throw new Error(`Informe um valor válido entre R$ 0,01 e ${fmtBRL(fin.remaining_amount)}.`);
          }

          const newPaidAmount = Number(Math.min(fin.total_amount, fin.paid_amount + addAmount).toFixed(2));
          const newStatus = newPaidAmount >= fin.total_amount ? 'pago' : 'pendente';

          let { data, error } = await sbClient
            .from('orders')
            .update({ payment_status: newStatus, paid_amount: newPaidAmount })
            .eq('id', Number(orderId))
            .select()
            .single();

          if (error && String(error.message || '').includes('paid_amount')) {
            const retry = await sbClient
              .from('orders')
              .update({ payment_status: newStatus })
              .eq('id', Number(orderId))
              .select()
              .single();
            data = retry.data;
            error = retry.error;
          }
          if (error) throw new Error(error.message);

          if (newStatus === 'pago') {
            delete bridge.paidAmountsMap[orderId];
          } else {
            bridge.paidAmountsMap[orderId] = newPaidAmount;
          }
          saveEventsBridge(bridge);
          return enrichOrderFinancials({ ...data, paid_amount: newPaidAmount }, bridge.paidAmountsMap);
        }
        const db = loadLocalDb();
        const ord = db.orders.find((o) => Number(o.id) === Number(orderId));
        if (!ord) throw new Error('Pedido não encontrado');
        const fin = enrichOrderFinancials(ord);
        const addAmount = amount !== null ? Number(Number(amount).toFixed(2)) : fin.remaining_amount;
        const newPaid = Number(Math.min(fin.total_amount, fin.paid_amount + addAmount).toFixed(2));
        ord.paid_amount = newPaid;
        ord.payment_status = newPaid >= fin.total_amount ? 'pago' : 'pendente';
        saveLocalDb(db);
        return enrichOrderFinancials(ord);
      }
    };

    function startEditProduct(productId) {
      const prod = cachedProducts.find((p) => Number(p.id) === Number(productId));
      if (!prod) return;

      document.getElementById('prod-edit-id').value = prod.id;
      document.getElementById('prod-name').value = prod.name;
      document.getElementById('prod-category').value = prod.category_id;
      document.getElementById('prod-price').value = prod.price;
      document.getElementById('prod-stock').value =
        prod.stock_quantity === null || prod.stock_quantity === undefined ? '' : prod.stock_quantity;

      document.getElementById('product-form-title').textContent = `Editar Produto #${prod.id}`;
      document.getElementById('prod-submit-btn').textContent = 'Salvar Alterações';
      document.getElementById('prod-cancel-btn').style.display = 'inline-block';
      document.getElementById('prod-name').focus();
    }

    function cancelEditProduct() {
      document.getElementById('prod-edit-id').value = '';
      document.getElementById('prod-name').value = '';
      document.getElementById('prod-price').value = '';
      document.getElementById('prod-stock').value = '';
      document.getElementById('product-form-title').textContent = 'Cadastrar Novo Produto';
      document.getElementById('prod-submit-btn').textContent = 'Salvar Produto';
      document.getElementById('prod-cancel-btn').style.display = 'none';
    }

    function onChangeActiveEvent(val) {
      selectedEventId = String(val);
      localStorage.setItem('csj_selected_event_id', selectedEventId);
      loadDashboard();
    }

    async function setEventStatus(eventId, newStatus, openCashScreen = false) {
      try {
        await DataService.updateEvent(eventId, { status: newStatus });
        selectedEventId = String(eventId);
        localStorage.setItem('csj_selected_event_id', selectedEventId);
        if (newStatus === 'aberto') {
          showToast('Vendas iniciadas para o evento!');
        } else if (newStatus === 'encerrado') {
          showToast('Evento encerrado! O histórico e a baixa de pendências continuam disponíveis.');
        }
        await loadDashboard();
        if (openCashScreen) switchScreen('orders');
      } catch (err) {
        showToast(err.message);
      }
    }

    function openSelectedEventSales() {
      if (!selectedEventId || selectedEventId === 'all') return;
      setEventStatus(Number(selectedEventId), 'aberto', false);
    }

    async function promptUpdateAttendance(eventIdParam) {
      const targetId = eventIdParam || (selectedEventId !== 'all' ? Number(selectedEventId) : null);
      const ev = cachedEvents.find((e) => Number(e.id) === Number(targetId));
      if (!ev) {
        showToast('Selecione um evento específico primeiro.');
        return;
      }
      const input = window.prompt(
        `Quantos jovens participaram/estiveram presentes no evento "${ev.name}"?`,
        String(ev.attendance_count || 0)
      );
      if (input === null) return;
      const num = Number(input);
      if (!Number.isInteger(num) || num < 0) {
        showToast('Informe um número inteiro válido maior ou igual a zero.');
        return;
      }
      try {
        await DataService.updateEvent(ev.id, { attendance_count: num });
        showToast(`Público presente atualizado para ${num} jovens!`);
        loadDashboard();
      } catch (err) {
        showToast(err.message);
      }
    }

    function selectEventAndOpenCash(eventId) {
      selectedEventId = String(eventId);
      localStorage.setItem('csj_selected_event_id', selectedEventId);
      loadDashboard();
      switchScreen('orders');
    }

    async function loadDashboard() {
      try {
        const [categories, products, allOrders] = await Promise.all([
          DataService.getCategories(),
          DataService.getProducts(),
          DataService.getOrders()
        ]);
        const events = await DataService.getEvents(allOrders);

        cachedCategories = categories || [];
        cachedProducts = products || [];
        cachedEvents = events || [];
        updateEnvUi();

        // Garantir que haja ao menos 1 evento selecionado
        if (!selectedEventId || (selectedEventId !== 'all' && !cachedEvents.some((e) => String(e.id) === String(selectedEventId)))) {
          const openEv = cachedEvents.find((e) => e.status === 'aberto') || cachedEvents[0];
          selectedEventId = openEv ? String(openEv.id) : 'all';
          localStorage.setItem('csj_selected_event_id', selectedEventId);
        }

        // Autocomplete de Nomes de Clientes (unificando nomes já digitados)
        const datalist = document.getElementById('customers-datalist');
        datalist.innerHTML = '';
        const knownNamesMap = new Map();
        (allOrders || []).forEach((o) => {
          const k = normalizeCustomerKey(o.customer_name);
          if (k && !knownNamesMap.has(k)) knownNamesMap.set(k, o.customer_name.trim());
        });
        knownNamesMap.forEach((displayName) => {
          const opt = document.createElement('option');
          opt.value = displayName;
          datalist.appendChild(opt);
        });

        // Renderizar Tela 0: Eventos & Adesão
        const openEventsCount = cachedEvents.filter((e) => e.status === 'aberto').length;
        const totalRevenueAll = cachedEvents.reduce((s, e) => s + (e.total_sales || 0), 0);
        const eventsWithAdherence = cachedEvents.filter((e) => e.adherence_rate !== null);
        const avgAdherence = eventsWithAdherence.length
          ? Number((eventsWithAdherence.reduce((s, e) => s + e.adherence_rate, 0) / eventsWithAdherence.length).toFixed(1))
          : 0;

        document.getElementById('ev-stat-count').textContent = String(cachedEvents.length);
        document.getElementById('ev-stat-open').textContent = `${openEventsCount} em andamento`;
        document.getElementById('ev-stat-adherence').textContent = `${avgAdherence}%`;
        document.getElementById('ev-stat-buyers').textContent = `${knownNamesMap.size} jovens compradores únicos`;
        document.getElementById('ev-stat-revenue').textContent = fmtBRL(totalRevenueAll);

        const evListEl = document.getElementById('events-list-container');
        evListEl.innerHTML = '';
        if (cachedEvents.length === 0) {
          evListEl.innerHTML = '<p style="color:var(--muted);text-align:center;padding:1rem;">Nenhum evento cadastrado ainda. Crie o primeiro ao lado!</p>';
        } else {
          cachedEvents.forEach((ev) => {
            const isSelected = String(ev.id) === String(selectedEventId);
            const statusLabel = ev.status === 'aberto' ? 'Em Andamento' : ev.status === 'agendado' ? 'Agendado' : 'Encerrado';
            const adherenceText = ev.adherence_rate !== null ? `${ev.adherence_rate}%` : 'Definir público';
            const pctWidth = ev.adherence_rate !== null ? Math.min(100, Math.round(ev.adherence_rate)) : 0;

            let actionsHtml = '';
            if (ev.status === 'agendado') {
              actionsHtml = `
                <button type="button" class="btn-success" onclick="setEventStatus(${ev.id}, 'aberto', true)">▶ Iniciar Vendas</button>
                <button type="button" class="btn-secondary" onclick="promptUpdateAttendance(${ev.id})">👥 Informar Presentes</button>
              `;
            } else if (ev.status === 'aberto') {
              actionsHtml = `
                <button type="button" class="btn-primary" onclick="selectEventAndOpenCash(${ev.id})">🛒 Abrir Caixa</button>
                <button type="button" class="btn-secondary" onclick="promptUpdateAttendance(${ev.id})">👥 Presentes (${ev.attendance_count})</button>
                <button type="button" class="btn-warning" onclick="setEventStatus(${ev.id}, 'encerrado', false)">⏹ Encerrar Evento</button>
              `;
            } else {
              actionsHtml = `
                <button type="button" class="btn-secondary" onclick="selectEventAndOpenCash(${ev.id})">👁 Ver Caixa / Pendências</button>
                <button type="button" class="btn-secondary" onclick="promptUpdateAttendance(${ev.id})">👥 Presentes (${ev.attendance_count})</button>
                <button type="button" class="btn-edit" onclick="setEventStatus(${ev.id}, 'aberto', true)">🔄 Reabrir Vendas</button>
              `;
            }

            const itemDiv = document.createElement('div');
            itemDiv.className = `event-item ${ev.status === 'aberto' ? 'active-event' : ''}`;
            itemDiv.innerHTML = `
              <div class="event-header">
                <div>
                  <strong style="font-size:0.98rem;">${ev.name}</strong>
                  <div style="font-size:0.78rem;color:var(--muted);">📅 Data: ${fmtDateBR(ev.event_date)} ${isSelected ? ' • (Selecionado no Caixa)' : ''}</div>
                </div>
                <span class="tag tag-${ev.status}">${statusLabel}</span>
              </div>
              <div class="event-metrics-grid">
                <div class="event-metric-box">
                  <small>Jovens Presentes</small>
                  <strong>${ev.attendance_count || 0}</strong>
                </div>
                <div class="event-metric-box">
                  <small>Compraram (Únicos)</small>
                  <strong>${ev.unique_buyers_count || 0}</strong>
                </div>
                <div class="event-metric-box">
                  <small>% de Adesão</small>
                  <strong class="text-primary">${adherenceText}</strong>
                </div>
                <div class="event-metric-box">
                  <small>Ticket Médio</small>
                  <strong>${fmtBRL(ev.avg_ticket)}</strong>
                </div>
              </div>
              <div class="progress-bar" title="Taxa de Adesão: ${adherenceText}">
                <div class="progress-fill" style="width: ${pctWidth}%;"></div>
              </div>
              <div style="display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap;gap:0.5rem;">
                <div style="font-size:0.78rem;color:var(--muted);">
                  Pago: <strong class="text-success">${fmtBRL(ev.total_paid)}</strong> &nbsp;|&nbsp;
                  Pendente: <strong class="text-warning">${fmtBRL(ev.total_pending)}</strong>
                </div>
                <div class="event-actions">${actionsHtml}</div>
              </div>
            `;
            evListEl.appendChild(itemDiv);
          });
        }

        // Renderizar Seletor de Evento Ativo na Tela 1 (Caixa / Pedidos)
        const evSelect = document.getElementById('active-event-select');
        evSelect.innerHTML = '';
        cachedEvents.forEach((ev) => {
          const opt = document.createElement('option');
          opt.value = String(ev.id);
          const st = ev.status === 'aberto' ? '🟢' : ev.status === 'agendado' ? '🟡' : '⚪';
          opt.textContent = `${st} ${ev.name} (${fmtDateBR(ev.event_date)})`;
          evSelect.appendChild(opt);
        });
        const allOpt = document.createElement('option');
        allOpt.value = 'all';
        allOpt.textContent = '📊 Todos os Eventos (Geral)';
        evSelect.appendChild(allOpt);
        evSelect.value = String(selectedEventId);

        const activeEv = cachedEvents.find((e) => String(e.id) === String(selectedEventId));
        const badgeEl = document.getElementById('active-event-badge');
        const closedNotice = document.getElementById('closed-order-notice');
        const submitBtn = document.getElementById('order-submit-btn');

        if (activeEv) {
          const stLabel = activeEv.status === 'aberto' ? 'Em Andamento' : activeEv.status === 'agendado' ? 'Agendado' : 'Encerrado';
          badgeEl.className = `tag tag-${activeEv.status}`;
          badgeEl.textContent = stLabel;
          document.getElementById('banner-attendance').textContent = String(activeEv.attendance_count || 0);
          document.getElementById('banner-buyers').textContent = String(activeEv.unique_buyers_count || 0);
          document.getElementById('banner-adherence').textContent =
            activeEv.adherence_rate !== null ? `${activeEv.adherence_rate}%` : 'Definir presentes';

          if (activeEv.status !== 'aberto') {
            closedNotice.style.display = 'block';
            document.getElementById('closed-order-text').textContent =
              activeEv.status === 'agendado'
                ? `O evento "${activeEv.name}" está agendado para ${fmtDateBR(activeEv.event_date)}. Inicie as vendas para lançar pedidos.`
                : `O evento "${activeEv.name}" já foi encerrado. Você ainda pode dar baixa nas pendências ao lado ou reabrir as vendas.`;
            submitBtn.disabled = true;
            submitBtn.style.opacity = '0.5';
          } else {
            closedNotice.style.display = 'none';
            submitBtn.disabled = false;
            submitBtn.style.opacity = '1';
          }
        } else {
          badgeEl.className = 'tag tag-aberto';
          badgeEl.textContent = 'Visão Geral';
          document.getElementById('banner-attendance').textContent = '-';
          document.getElementById('banner-buyers').textContent = String(knownNamesMap.size);
          document.getElementById('banner-adherence').textContent = `${avgAdherence}%`;
          closedNotice.style.display = 'none';
          submitBtn.disabled = false;
          submitBtn.style.opacity = '1';
        }

        // Filtrar pedidos pelo Evento Selecionado
        const filteredOrders =
          selectedEventId === 'all'
            ? allOrders
            : allOrders.filter((o) => String(o.event_id || 1) === String(selectedEventId));

        let totalPaid = 0;
        let totalPending = 0;
        let paidCount = 0;
        let pendingCount = 0;
        const byMethod = {};
        const pendingOrders = [];

        filteredOrders.forEach((o) => {
          const fin = enrichOrderFinancials(o);
          if (fin.paid_amount > 0) {
            totalPaid += fin.paid_amount;
            const m = (o.payment_method || 'outros').toLowerCase();
            byMethod[m] = Number(((byMethod[m] || 0) + fin.paid_amount).toFixed(2));
          }
          if (o.payment_status === 'pago' || fin.remaining_amount <= 0) {
            paidCount++;
          } else {
            totalPending += fin.remaining_amount;
            pendingCount++;
            pendingOrders.push(fin);
          }
        });

        // Verificar pendências de outros eventos
        const otherPending =
          selectedEventId === 'all'
            ? []
            : allOrders.filter((o) => o.payment_status === 'pendente' && String(o.event_id || 1) !== String(selectedEventId));
        const otherAlertEl = document.getElementById('other-pending-alert');
        if (otherPending.length > 0) {
          const otherSum = otherPending.reduce((s, o) => s + enrichOrderFinancials(o).remaining_amount, 0);
          document.getElementById('other-pending-text').textContent =
            `⚠ Há ${otherPending.length} pedido(s) pendente(s) de outros eventos (${fmtBRL(otherSum)}).`;
          otherAlertEl.style.display = 'flex';
        } else {
          otherAlertEl.style.display = 'none';
        }

        // Preencher Select e Pills de Categorias (Tela 2)
        const catSelect = document.getElementById('prod-category');
        const catPills = document.getElementById('categories-pills');
        const currentCatVal = catSelect.value;
        catSelect.innerHTML = '';
        catPills.innerHTML = '';

        (categories || []).forEach((c) => {
          const opt = document.createElement('option');
          opt.value = c.id;
          opt.textContent = c.name;
          catSelect.appendChild(opt);

          const pill = document.createElement('span');
          pill.className = 'cat-pill';
          pill.textContent = c.name;
          catPills.appendChild(pill);
        });
        if (currentCatVal) catSelect.value = currentCatVal;

        // Preencher Select de Produtos (Tela 1) e Tabela de Produtos (Tela 2)
        const select = document.getElementById('order-product');
        const prodTbody = document.getElementById('products-tbody');
        select.innerHTML = '';
        prodTbody.innerHTML = '';

        cachedProducts.forEach((p) => {
          const stockLabel =
            p.stock_quantity === null || p.stock_quantity === undefined
              ? '<span style="color:var(--muted)">Livre</span>'
              : `<strong>${p.stock_quantity} un.</strong>`;

          const opt = document.createElement('option');
          opt.value = p.id;
          opt.textContent = `${p.name} — ${fmtBRL(p.price)}${p.stock_quantity !== null ? ` (Est: ${p.stock_quantity})` : ''}`;
          select.appendChild(opt);

          const tr = document.createElement('tr');
          tr.innerHTML = `
            <td><strong>${p.name}</strong></td>
            <td>${p.category_name || '-'}</td>
            <td>${fmtBRL(p.price)}</td>
            <td>${stockLabel}</td>
            <td><button type="button" class="btn-edit" onclick="startEditProduct(${p.id})">Editar</button></td>
          `;
          prodTbody.appendChild(tr);
        });

        // Preencher Resumo do Caixa (Tela 1)
        document.getElementById('stat-paid').textContent = fmtBRL(totalPaid);
        document.getElementById('stat-paid-count').textContent = `${paidCount} pedido(s) quitado(s)`;
        document.getElementById('stat-pending').textContent = fmtBRL(totalPending);
        document.getElementById('stat-pending-count').textContent = `${pendingCount} pedido(s) em aberto`;

        const methodsEntries = Object.entries(byMethod);
        document.getElementById('stat-methods').innerHTML = methodsEntries.length
          ? methodsEntries.map(([m, val]) => `<strong>${m.toUpperCase()}:</strong> ${fmtBRL(val)}`).join(' &nbsp;|&nbsp; ')
          : 'Nenhum pagamento confirmado neste filtro';

        // Preencher Pedidos Pendentes (Tela 1)
        const pendingTbody = document.getElementById('pending-tbody');
        pendingTbody.innerHTML = '';
        if (pendingOrders.length === 0) {
          pendingTbody.innerHTML = '<tr><td colspan="5" style="color:var(--muted);text-align:center;padding:1rem;">Nenhum pedido pendente!</td></tr>';
        } else {
          pendingOrders.forEach((o) => {
            const tr = document.createElement('tr');
            const valHtml = o.is_partial
              ? `<div class="text-warning"><strong>Falta: ${fmtBRL(o.remaining_amount)}</strong></div>
                 <div style="font-size:0.7rem;color:var(--muted);">Total ${fmtBRL(o.total_amount)} • Pago ${fmtBRL(o.paid_amount)}</div>`
              : `<div class="text-warning"><strong>${fmtBRL(o.remaining_amount)}</strong></div>`;
            tr.innerHTML = `
              <td>#${o.id}</td>
              <td><strong>${o.customer_name}</strong></td>
              <td>${(o.payment_method || '').toUpperCase()}</td>
              <td>${valHtml}</td>
              <td>
                <div style="display:flex;gap:0.3rem;flex-wrap:wrap;">
                  <button type="button" class="btn-warning" onclick="handlePartialPayOrder(${o.id}, ${o.remaining_amount})" style="padding:0.26rem 0.5rem;font-size:0.74rem;">Parcial</button>
                  <button type="button" class="btn-success" onclick="handlePayOrder(${o.id})" style="padding:0.26rem 0.5rem;font-size:0.74rem;">Quitar</button>
                </div>
              </td>
            `;
            pendingTbody.appendChild(tr);
          });
        }

        // Preencher Pedidos Registrados (Tela 1)
        const ordersTbody = document.getElementById('orders-tbody');
        ordersTbody.innerHTML = '';
        if (filteredOrders.length === 0) {
          ordersTbody.innerHTML = '<tr><td colspan="5" style="color:var(--muted);text-align:center;padding:1rem;">Nenhum pedido registrado neste evento ainda.</td></tr>';
        } else {
          filteredOrders.slice(0, 12).forEach((o) => {
            const fin = enrichOrderFinancials(o);
            const itemsDesc = (o.order_items || [])
              .map((i) => `${i.quantity}x ${i.products ? i.products.name : 'Item'}`)
              .join(', ');
            let statusHtml = '';
            if (o.payment_status === 'pago' || fin.remaining_amount <= 0) {
              statusHtml = '<span class="tag tag-pago">pago</span>';
            } else if (fin.is_partial) {
              statusHtml = `<span class="tag tag-parcial">parcial (faltam ${fmtBRL(fin.remaining_amount)})</span>`;
            } else {
              statusHtml = '<span class="tag tag-pendente">pendente</span>';
            }
            const tr = document.createElement('tr');
            tr.innerHTML = `
              <td>#${o.id}</td>
              <td>${o.customer_name}</td>
              <td style="font-size:0.76rem;color:var(--muted);">${itemsDesc || '-'}</td>
              <td>${fmtBRL(o.total_amount)}</td>
              <td>${statusHtml}</td>
            `;
            ordersTbody.appendChild(tr);
          });
        }
        // Atualizar prévia do carrinho
        renderOrderCart();
      } catch (err) {
        showToast(err.message || 'Erro ao carregar dados');
      }
    }

    async function handlePayOrder(id) {
      try {
        await DataService.payOrder(id);
        showToast(`Pedido #${id} quitado com sucesso!`);
        loadDashboard();
      } catch (err) {
        showToast(err.message);
      }
    }

    async function handlePartialPayOrder(id, remainingAmount) {
      const raw = window.prompt(
        `Pagamento Parcial do Pedido #${id}\nSaldo pendente atual: ${fmtBRL(remainingAmount)}\n\nQual valor (R$) o cliente está pagando agora?`,
        ''
      );
      if (raw === null || !raw.trim()) return;
      const amount = Number(raw.replace(',', '.').trim());
      if (Number.isNaN(amount) || amount <= 0 || amount > Number(remainingAmount) + 0.001) {
        showToast(`Informe um valor válido entre R$ 0,01 e ${fmtBRL(remainingAmount)}.`);
        return;
      }
      try {
        const updated = await DataService.payOrder(id, amount);
        if (updated.payment_status === 'pago' || updated.remaining_amount <= 0) {
          showToast(`Pedido #${id} quitado totalmente!`);
        } else {
          showToast(`Abatido ${fmtBRL(amount)} no Pedido #${id}! Restam ${fmtBRL(updated.remaining_amount)}.`);
        }
        loadDashboard();
      } catch (err) {
        showToast(err.message);
      }
    }

    document.getElementById('event-form').addEventListener('submit', async (e) => {
      e.preventDefault();
      try {
        const name = document.getElementById('ev-name').value.trim();
        const event_date = document.getElementById('ev-date').value;
        const attRaw = document.getElementById('ev-attendance').value.trim();
        const status = document.getElementById('ev-status').value;

        const created = await DataService.createEvent({
          name,
          event_date,
          attendance_count: attRaw === '' ? 0 : Number(attRaw),
          status
        });

        document.getElementById('ev-name').value = '';
        document.getElementById('ev-attendance').value = '';
        selectedEventId = String(created.id);
        localStorage.setItem('csj_selected_event_id', selectedEventId);
        showToast(`Evento "${created.name}" criado!`);
        await loadDashboard();
        if (status === 'aberto') {
          switchScreen('orders');
        }
      } catch (err) {
        showToast(err.message);
      }
    });

    document.getElementById('order-product').addEventListener('change', renderOrderCart);
    document.getElementById('order-qty').addEventListener('input', renderOrderCart);

    document.getElementById('order-form').addEventListener('submit', async (e) => {
      e.preventDefault();
      try {
        const targetEvId = selectedEventId === 'all' ? (cachedEvents[0] ? cachedEvents[0].id : 1) : Number(selectedEventId);
        const itemsToSend =
          orderCart.length > 0
            ? orderCart.map((i) => ({ product_id: Number(i.product_id), quantity: Number(i.quantity) }))
            : [
                {
                  product_id: Number(document.getElementById('order-product').value),
                  quantity: Math.max(1, Number(document.getElementById('order-qty').value || 1))
                }
              ];

        const statusVal = document.getElementById('order-status').value;
        const paidNowRaw = document.getElementById('order-paid-now').value.trim();
        const paidAmountVal = statusVal === 'parcial' ? Number(paidNowRaw.replace(',', '.')) : undefined;

        const payload = {
          event_id: targetEvId,
          customer_name: document.getElementById('order-customer').value.trim(),
          payment_method: document.getElementById('order-method').value,
          payment_status: statusVal,
          paid_amount: paidAmountVal,
          items: itemsToSend
        };
        const created = await DataService.createOrder(payload);
        document.getElementById('order-customer').value = '';
        document.getElementById('order-qty').value = '1';
        document.getElementById('order-paid-now').value = '';
        if (statusVal === 'parcial') {
          document.getElementById('order-status').value = 'pago';
          onOrderStatusChange();
        }
        orderCart = [];
        renderOrderCart();
        showToast(`Pedido #${created.id} registrado (${fmtBRL(created.total_amount)})!`);
        loadDashboard();
      } catch (err) {
        showToast(err.message);
      }
    });

    document.getElementById('product-form').addEventListener('submit', async (e) => {
      e.preventDefault();
      try {
        const editId = document.getElementById('prod-edit-id').value;
        const stockRaw = document.getElementById('prod-stock').value.trim();
        const payload = {
          name: document.getElementById('prod-name').value.trim(),
          category_id: Number(document.getElementById('prod-category').value),
          price: Number(document.getElementById('prod-price').value),
          stock_quantity: stockRaw === '' ? null : Number(stockRaw)
        };

        if (editId) {
          const updated = await DataService.updateProduct(editId, payload);
          showToast(`Produto "${updated.name}" atualizado com sucesso!`);
          cancelEditProduct();
        } else {
          const created = await DataService.createProduct(payload);
          document.getElementById('prod-name').value = '';
          document.getElementById('prod-price').value = '';
          document.getElementById('prod-stock').value = '';
          showToast(`Produto "${created.name}" cadastrado com sucesso!`);
        }
        loadDashboard();
      } catch (err) {
        showToast(err.message);
      }
    });

    document.getElementById('category-form').addEventListener('submit', async (e) => {
      e.preventDefault();
      try {
        const name = document.getElementById('cat-name').value.trim();
        if (!name) return;
        const created = await DataService.createCategory({ name });
        document.getElementById('cat-name').value = '';
        showToast(`Categoria "${created.name}" criada!`);
        loadDashboard();
      } catch (err) {
        showToast(err.message);
      }
    });

    updateEnvUi();
    loadDashboard();

    // Registro do Service Worker e suporte a Instalação PWA no Celular (Android / iOS)
    let deferredInstallPrompt = null;
    if ('serviceWorker' in navigator) {
      window.addEventListener('load', () => {
        navigator.serviceWorker.register('./sw.js').catch(() => {});
      });
    }

    window.addEventListener('beforeinstallprompt', (e) => {
      e.preventDefault();
      deferredInstallPrompt = e;
      const btn = document.getElementById('btn-install-pwa');
      if (btn) btn.style.display = 'inline-block';
    });

    window.addEventListener('appinstalled', () => {
      deferredInstallPrompt = null;
      const btn = document.getElementById('btn-install-pwa');
      if (btn) btn.style.display = 'none';
      showToast('Aplicativo instalado com sucesso na tela inicial!');
    });

    const isIos = /iphone|ipad|ipod/i.test(window.navigator.userAgent);
    const isInStandaloneMode = ('standalone' in window.navigator && window.navigator.standalone) || window.matchMedia('(display-mode: standalone)').matches;
    if (isIos && !isInStandaloneMode) {
      const btn = document.getElementById('btn-install-pwa');
      if (btn) btn.style.display = 'inline-block';
    }

    async function installPwaApp() {
      if (deferredInstallPrompt) {
        deferredInstallPrompt.prompt();
        await deferredInstallPrompt.userChoice;
        deferredInstallPrompt = null;
        document.getElementById('btn-install-pwa').style.display = 'none';
      } else if (isIos) {
        showToast('No iPhone: toque no ícone Compartilhar (barra inferior) e escolha "Adicionar à Tela de Início".');
      } else {
        showToast('Abra o menu do navegador (⋮) e toque em "Instalar aplicativo" ou "Adicionar à tela inicial".');
      }
    }
  </script>
</body>
</html>
