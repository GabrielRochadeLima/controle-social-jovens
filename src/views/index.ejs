<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Controle Social Jovens — Frente de Caixa & Fechamento</title>
  <style>
    :root {
      --bg: #0f172a;
      --surface: #1e293b;
      --surface-hover: #334155;
      --border: #334155;
      --text: #f8fafc;
      --muted: #94a3b8;
      --primary: #3b82f6;
      --primary-hover: #2563eb;
      --success: #10b981;
      --warning: #f59e0b;
      --danger: #ef4444;
    }
    * { box-sizing: border-box; margin: 0; padding: 0; }
    body {
      font-family: system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
      background-color: var(--bg);
      color: var(--text);
      line-height: 1.5;
      padding: 1.5rem;
    }
    header {
      display: flex;
      flex-wrap: wrap;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 1.5rem;
      padding-bottom: 1rem;
      border-bottom: 1px solid var(--border);
    }
    header h1 { font-size: 1.5rem; font-weight: 700; }
    .badge-schema {
      background: rgba(59, 130, 246, 0.15);
      color: #60a5fa;
      border: 1px solid rgba(59, 130, 246, 0.4);
      padding: 0.25rem 0.75rem;
      border-radius: 999px;
      font-size: 0.85rem;
      font-family: monospace;
    }
    .grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(340px, 1fr));
      gap: 1.25rem;
    }
    .card {
      background: var(--surface);
      border: 1px solid var(--border);
      border-radius: 0.75rem;
      padding: 1.25rem;
    }
    .card h2 {
      font-size: 1.15rem;
      margin-bottom: 1rem;
      display: flex;
      justify-content: space-between;
      align-items: center;
    }
    .stats-row {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
      gap: 1rem;
      margin-bottom: 1.5rem;
    }
    .stat-card {
      background: var(--surface);
      border: 1px solid var(--border);
      border-radius: 0.75rem;
      padding: 1rem;
    }
    .stat-card span { font-size: 0.85rem; color: var(--muted); }
    .stat-card strong { display: block; font-size: 1.5rem; margin-top: 0.25rem; }
    .text-success { color: var(--success); }
    .text-warning { color: var(--warning); }
    form { display: flex; flex-direction: column; gap: 0.75rem; }
    label { font-size: 0.85rem; color: var(--muted); }
    input, select, button {
      padding: 0.6rem 0.75rem;
      border-radius: 0.5rem;
      border: 1px solid var(--border);
      background: var(--bg);
      color: var(--text);
      font-size: 0.95rem;
    }
    button {
      background: var(--primary);
      border-color: var(--primary);
      font-weight: 600;
      cursor: pointer;
      transition: background 0.15s;
    }
    button:hover { background: var(--primary-hover); }
    button.btn-success { background: var(--success); border-color: var(--success); }
    table { width: 100%; border-collapse: collapse; font-size: 0.9rem; margin-top: 0.5rem; }
    th, td { text-align: left; padding: 0.6rem 0.5rem; border-bottom: 1px solid var(--border); }
    th { color: var(--muted); font-weight: 600; }
    .tag {
      display: inline-block;
      padding: 0.15rem 0.5rem;
      border-radius: 0.375rem;
      font-size: 0.75rem;
      font-weight: 600;
      text-transform: uppercase;
    }
    .tag-pago { background: rgba(16, 185, 129, 0.2); color: #34d399; }
    .tag-pendente { background: rgba(245, 158, 11, 0.2); color: #fbbf24; }
    #toast {
      position: fixed;
      bottom: 1.25rem;
      right: 1.25rem;
      background: #1e293b;
      border: 1px solid var(--primary);
      padding: 0.75rem 1rem;
      border-radius: 0.5rem;
      display: none;
    }
  </style>
</head>
<body>
  <header>
    <div>
      <h1>Controle Social Jovens</h1>
      <p style="color: var(--muted); font-size: 0.9rem;">Frente de Caixa, Controle de Estoque e Fechamento Financeiro</p>
    </div>
    <span class="badge-schema">schema: "<%= schema %>"</span>
  </header>

  <section class="stats-row" id="closing-stats">
    <div class="stat-card">
      <span>Total Recebido (Pago)</span>
      <strong class="text-success" id="stat-paid">R$ 0,00</strong>
    </div>
    <div class="stat-card">
      <span>Total Pendente ("Na Rua")</span>
      <strong class="text-warning" id="stat-pending">R$ 0,00</strong>
    </div>
    <div class="stat-card">
      <span>Por Forma de Pagamento (Pagos)</span>
      <div id="stat-methods" style="font-size: 0.85rem; margin-top: 0.35rem; color: var(--text);">-</div>
    </div>
  </section>

  <div class="grid">
    <!-- Novo Pedido -->
    <div class="card">
      <h2>Novo Pedido</h2>
      <form id="order-form">
        <div>
          <label>Nome do Cliente / Jovem</label>
          <input type="text" id="order-customer" placeholder="Ex: Gabriel Silva" required style="width: 100%;" />
        </div>
        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 0.5rem;">
          <div>
            <label>Pagamento</label>
            <select id="order-method" style="width: 100%;">
              <option value="pix">Pix</option>
              <option value="dinheiro">Dinheiro</option>
              <option value="cartao">Cartão</option>
            </select>
          </div>
          <div>
            <label>Status</label>
            <select id="order-status" style="width: 100%;">
              <option value="pago">Pago na hora</option>
              <option value="pendente">Pendente (Pagar depois)</option>
            </select>
          </div>
        </div>
        <div style="display: grid; grid-template-columns: 2fr 1fr; gap: 0.5rem;">
          <div>
            <label>Produto</label>
            <select id="order-product" style="width: 100%;"></select>
          </div>
          <div>
            <label>Qtd</label>
            <input type="number" id="order-qty" value="1" min="1" required style="width: 100%;" />
          </div>
        </div>
        <button type="submit">Registrar Pedido</button>
      </form>
    </div>

    <!-- Produtos e Estoque -->
    <div class="card">
      <h2>Produtos & Estoque</h2>
      <table>
        <thead>
          <tr>
            <th>Produto</th>
            <th>Categoria</th>
            <th>Preço</th>
            <th>Estoque</th>
          </tr>
        </thead>
        <tbody id="products-tbody"></tbody>
      </table>
    </div>

    <!-- Pedidos Pendentes (Para cobrar / dar baixa) -->
    <div class="card">
      <h2>Pedidos Pendentes ("Na Rua")</h2>
      <table>
        <thead>
          <tr>
            <th>#</th>
            <th>Cliente</th>
            <th>Valor</th>
            <th>Ação</th>
          </tr>
        </thead>
        <tbody id="pending-tbody"></tbody>
      </table>
    </div>
  </div>

  <div id="toast"></div>

  <script>
    const fmtBRL = (v) => Number(v || 0).toLocaleString('pt-BR', { style: 'currency', currency: 'BRL' });

    function showToast(msg) {
      const el = document.getElementById('toast');
      el.textContent = msg;
      el.style.display = 'block';
      setTimeout(() => { el.style.display = 'none'; }, 3000);
    }

    async function loadDashboard() {
      const [prodRes, closeRes] = await Promise.all([
        fetch('/products'),
        fetch('/cash-closing')
      ]);
      const products = await prodRes.json();
      const closing = await closeRes.json();

      // Preencher select e tabela de produtos
      const select = document.getElementById('order-product');
      const prodTbody = document.getElementById('products-tbody');
      select.innerHTML = '';
      prodTbody.innerHTML = '';

      products.forEach((p) => {
        const stockLabel = p.stock_quantity === null ? 'Livre (Sem controle)' : `${p.stock_quantity} un.`;
        const opt = document.createElement('option');
        opt.value = p.id;
        opt.textContent = `${p.name} (${fmtBRL(p.price)})`;
        select.appendChild(opt);

        const tr = document.createElement('tr');
        tr.innerHTML = `
          <td>${p.name}</td>
          <td>${p.category_name || '-'}</td>
          <td>${fmtBRL(p.price)}</td>
          <td>${stockLabel}</td>
        `;
        prodTbody.appendChild(tr);
      });

      // Preencher Fechamento de Caixa
      document.getElementById('stat-paid').textContent = fmtBRL(closing.total_paid);
      document.getElementById('stat-pending').textContent = fmtBRL(closing.total_pending);

      const methodsEntries = Object.entries(closing.by_payment_method || {});
      document.getElementById('stat-methods').innerHTML = methodsEntries.length
        ? methodsEntries.map(([m, val]) => `<strong>${m.toUpperCase()}:</strong> ${fmtBRL(val)}`).join(' | ')
        : 'Nenhum pagamento confirmado ainda';

      // Preencher Pedidos Pendentes
      const pendingTbody = document.getElementById('pending-tbody');
      pendingTbody.innerHTML = '';
      (closing.pending_orders || []).forEach((o) => {
        const tr = document.createElement('tr');
        tr.innerHTML = `
          <td>#${o.id}</td>
          <td>${o.customer_name} <small style="color:var(--muted)">(${o.payment_method})</small></td>
          <td>${fmtBRL(o.total_amount)}</td>
          <td><button class="btn-success" onclick="payOrder(${o.id})" style="padding:0.25rem 0.5rem;font-size:0.8rem;">Dar Baixa</button></td>
        `;
        pendingTbody.appendChild(tr);
      });
    }

    async function payOrder(id) {
      const res = await fetch(`/orders/${id}/pay`, { method: 'PATCH', headers: { 'Content-Type': 'application/json' } });
      if (res.ok) {
        showToast(`Pedido #${id} marcado como PAGO!`);
        loadDashboard();
      } else {
        const err = await res.json();
        showToast(err.error || 'Erro ao dar baixa');
      }
    }

    document.getElementById('order-form').addEventListener('submit', async (e) => {
      e.preventDefault();
      const payload = {
        customer_name: document.getElementById('order-customer').value,
        payment_method: document.getElementById('order-method').value,
        payment_status: document.getElementById('order-status').value,
        items: [
          {
            product_id: Number(document.getElementById('order-product').value),
            quantity: Number(document.getElementById('order-qty').value)
          }
        ]
      };
      const res = await fetch('/orders', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(payload)
      });
      const data = await res.json();
      if (res.ok) {
        document.getElementById('order-customer').value = '';
        showToast(`Pedido #${data.id} registrado (${fmtBRL(data.total_amount)})!`);
        loadDashboard();
      } else {
        showToast(data.error || 'Erro ao registrar pedido');
      }
    });

    loadDashboard();
  </script>
</body>
</html>
