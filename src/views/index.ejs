<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="theme-color" content="#0f172a" />
  <meta name="mobile-web-app-capable" content="yes" />
  <meta name="apple-mobile-web-app-capable" content="yes" />
  <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
  <meta name="apple-mobile-web-app-title" content="Social Jovens" />
  <link rel="manifest" href="./manifest.json?v=3" />
  <link rel="icon" type="image/png" sizes="192x192" href="./icon-192.png?v=3" />
  <link rel="apple-touch-icon" href="./icon-192.png?v=3" />
  <title>Controle Social Jovens</title>
  <script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2"></script>
  <style>
    :root {
      --bg: #0f172a;
      --surface: #1e293b;
      --surface-hover: #334155;
      --border: #334155;
      --text: #f8fafc;
      --muted: #94a3b8;
      --primary: #3b82f6;
      --primary-hover: #2563eb;
      --success: #10b981;
      --warning: #f59e0b;
      --danger: #ef4444;
    }
    * { box-sizing: border-box; margin: 0; padding: 0; }
    body {
      font-family: system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
      background-color: var(--bg);
      color: var(--text);
      line-height: 1.45;
      padding: 1.15rem;
      max-width: 1280px;
      margin: 0 auto;
    }
    header {
      display: flex;
      flex-wrap: wrap;
      justify-content: space-between;
      align-items: center;
      gap: 0.85rem;
      margin-bottom: 1.15rem;
      padding-bottom: 0.9rem;
      border-bottom: 1px solid var(--border);
    }
    .brand-box {
      display: flex;
      align-items: center;
      gap: 0.75rem;
    }
    .brand-logo {
      width: 44px;
      height: 44px;
      border-radius: 50%;
      object-fit: cover;
      border: 2px solid rgba(255, 255, 255, 0.15);
      flex-shrink: 0;
    }
    header h1 {
      font-size: 1.3rem;
      font-weight: 700;
      letter-spacing: -0.02em;
    }
    header p {
      color: var(--muted);
      font-size: 0.82rem;
    }
    .nav-tabs {
      display: flex;
      gap: 0.35rem;
      background: var(--surface);
      padding: 0.28rem;
      border-radius: 0.65rem;
      border: 1px solid var(--border);
    }
    .nav-tab {
      background: transparent;
      border: none;
      color: var(--muted);
      padding: 0.48rem 0.85rem;
      border-radius: 0.45rem;
      font-size: 0.85rem;
      font-weight: 600;
      cursor: pointer;
      transition: all 0.15s ease;
      white-space: nowrap;
    }
    .nav-tab:hover {
      color: var(--text);
      background: rgba(255, 255, 255, 0.04);
    }
    .nav-tab.active {
      background: var(--primary);
      color: #ffffff;
      box-shadow: 0 2px 8px rgba(59, 130, 246, 0.35);
    }
    .screen {
      display: none;
      animation: fadeIn 0.15s ease-out;
    }
    .screen.active {
      display: block;
    }
    @keyframes fadeIn {
      from { opacity: 0; transform: translateY(3px); }
      to { opacity: 1; transform: translateY(0); }
    }

    /* Barra do Evento Ativo na Tela de Pedidos */
    .event-banner {
      background: linear-gradient(135deg, rgba(30, 41, 59, 0.95), rgba(15, 23, 42, 0.95));
      border: 1px solid var(--border);
      border-left: 4px solid var(--primary);
      border-radius: 0.75rem;
      padding: 0.85rem 1rem;
      margin-bottom: 1rem;
      display: flex;
      flex-wrap: wrap;
      justify-content: space-between;
      align-items: center;
      gap: 0.75rem;
    }
    .event-banner-left {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      gap: 0.65rem;
      flex: 1;
    }
    .event-banner-metrics {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      gap: 0.6rem;
      font-size: 0.82rem;
    }
    .metric-chip {
      background: rgba(255, 255, 255, 0.05);
      border: 1px solid var(--border);
      border-radius: 0.5rem;
      padding: 0.3rem 0.65rem;
      display: inline-flex;
      align-items: center;
      gap: 0.35rem;
    }

    .stats-row {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 0.85rem;
      margin-bottom: 1.1rem;
    }
    .stat-card {
      background: var(--surface);
      border: 1px solid var(--border);
      border-radius: 0.7rem;
      padding: 0.85rem 1.05rem;
    }
    .stat-card span {
      font-size: 0.78rem;
      color: var(--muted);
      display: block;
    }
    .stat-card strong {
      display: block;
      font-size: 1.4rem;
      margin-top: 0.15rem;
      line-height: 1.2;
    }
    .stat-card small {
      font-size: 0.75rem;
      color: var(--muted);
    }
    .text-success { color: var(--success); }
    .text-warning { color: var(--warning); }
    .text-primary { color: #60a5fa; }

    .grid-2 {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
      gap: 1rem;
      align-items: start;
      width: 100%;
      min-width: 0;
    }
    .card {
      background: var(--surface);
      border: 1px solid var(--border);
      border-radius: 0.75rem;
      padding: 1.1rem;
      width: 100%;
      max-width: 100%;
      min-width: 0;
      box-sizing: border-box;
    }
    .product-add-row {
      display: grid;
      grid-template-columns: 1fr 78px auto;
      gap: 0.45rem;
      align-items: end;
      width: 100%;
      min-width: 0;
    }
    .btn-add-item {
      white-space: nowrap;
      height: 38px;
    }
    .card h2 {
      font-size: 1rem;
      margin-bottom: 0.85rem;
      display: flex;
      justify-content: space-between;
      align-items: center;
      border-bottom: 1px solid var(--border);
      padding-bottom: 0.5rem;
    }
    form { display: flex; flex-direction: column; gap: 0.7rem; }
    label {
      font-size: 0.79rem;
      color: var(--muted);
      display: block;
      margin-bottom: 0.22rem;
      font-weight: 500;
    }
    input, select, button {
      padding: 0.55rem 0.72rem;
      border-radius: 0.5rem;
      border: 1px solid var(--border);
      background: var(--bg);
      color: var(--text);
      font-size: 0.88rem;
    }
    input:focus, select:focus {
      outline: none;
      border-color: var(--primary);
    }
    button.btn-primary {
      background: var(--primary);
      border-color: var(--primary);
      color: #fff;
      font-weight: 600;
      cursor: pointer;
      padding: 0.62rem 0.9rem;
      transition: background 0.15s;
    }
    button.btn-primary:hover { background: var(--primary-hover); }
    button.btn-secondary {
      background: var(--surface-hover);
      border-color: var(--border);
      color: var(--text);
      font-weight: 600;
      cursor: pointer;
      padding: 0.5rem 0.8rem;
    }
    button.btn-success {
      background: var(--success);
      border-color: var(--success);
      color: #fff;
      font-weight: 600;
      cursor: pointer;
    }
    button.btn-warning {
      background: rgba(245, 158, 11, 0.2);
      border: 1px solid rgba(245, 158, 11, 0.5);
      color: #fbbf24;
      font-weight: 600;
      cursor: pointer;
    }
    button.btn-edit {
      background: rgba(59, 130, 246, 0.16);
      border: 1px solid rgba(59, 130, 246, 0.4);
      color: #60a5fa;
      font-weight: 600;
      padding: 0.26rem 0.55rem;
      font-size: 0.76rem;
      cursor: pointer;
    }
    .table-wrap {
      width: 100%;
      overflow-x: auto;
      -webkit-overflow-scrolling: touch;
    }
    table {
      width: 100%;
      border-collapse: collapse;
      font-size: 0.84rem;
      margin-top: 0.2rem;
    }
    th, td {
      text-align: left;
      padding: 0.5rem 0.38rem;
      border-bottom: 1px solid var(--border);
    }
    th {
      color: var(--muted);
      font-weight: 600;
      font-size: 0.74rem;
      text-transform: uppercase;
      letter-spacing: 0.03em;
    }
    .tag {
      display: inline-block;
      padding: 0.14rem 0.48rem;
      border-radius: 0.35rem;
      font-size: 0.7rem;
      font-weight: 600;
      text-transform: uppercase;
    }
    .tag-pago, .tag-aberto { background: rgba(16, 185, 129, 0.2); color: #34d399; }
    .tag-pendente, .tag-agendado { background: rgba(245, 158, 11, 0.2); color: #fbbf24; }
    .tag-parcial { background: rgba(59, 130, 246, 0.22); color: #60a5fa; }
    .tag-encerrado { background: rgba(148, 163, 184, 0.2); color: #cbd5e1; }

    /* Cards de Evento e Barra de Adesão */
    .events-list {
      display: flex;
      flex-direction: column;
      gap: 0.8rem;
    }
    .event-item {
      background: var(--bg);
      border: 1px solid var(--border);
      border-radius: 0.65rem;
      padding: 0.9rem;
    }
    .event-item.active-event {
      border-color: var(--success);
    }
    .event-header {
      display: flex;
      justify-content: space-between;
      align-items: flex-start;
      gap: 0.5rem;
      margin-bottom: 0.65rem;
    }
    .event-metrics-grid {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 0.45rem;
      margin-bottom: 0.65rem;
    }
    .event-metric-box {
      background: var(--surface);
      border: 1px solid var(--border);
      border-radius: 0.45rem;
      padding: 0.45rem 0.55rem;
    }
    .event-metric-box small {
      font-size: 0.68rem;
      color: var(--muted);
      display: block;
    }
    .event-metric-box strong {
      font-size: 0.92rem;
      display: block;
      margin-top: 0.1rem;
    }
    .progress-bar {
      width: 100%;
      height: 6px;
      background: var(--surface);
      border-radius: 999px;
      overflow: hidden;
      margin-bottom: 0.7rem;
    }
    .progress-fill {
      height: 100%;
      background: linear-gradient(90deg, var(--primary), var(--success));
      border-radius: 999px;
      transition: width 0.25s ease;
    }
    .event-actions {
      display: flex;
      flex-wrap: wrap;
      gap: 0.45rem;
    }
    .event-actions button {
      font-size: 0.78rem;
      padding: 0.38rem 0.68rem;
    }

    .cat-pills {
      display: flex;
      flex-wrap: wrap;
      gap: 0.4rem;
      margin-top: 0.6rem;
    }
    .cat-pill {
      background: rgba(255, 255, 255, 0.06);
      border: 1px solid var(--border);
      padding: 0.2rem 0.58rem;
      border-radius: 999px;
      font-size: 0.76rem;
      color: var(--text);
    }

    /* Carrinho / Múltiplos Itens no Pedido */
    .cart-box {
      background: var(--bg);
      border: 1px solid var(--border);
      border-radius: 0.55rem;
      padding: 0.65rem;
      display: flex;
      flex-direction: column;
      gap: 0.45rem;
    }
    .cart-item-row {
      display: flex;
      justify-content: space-between;
      align-items: center;
      gap: 0.5rem;
      padding: 0.4rem 0.5rem;
      background: var(--surface);
      border: 1px solid var(--border);
      border-radius: 0.45rem;
      font-size: 0.82rem;
    }
    .cart-item-controls {
      display: flex;
      align-items: center;
      gap: 0.35rem;
    }
    .cart-qty-btn {
      padding: 0.15rem 0.48rem;
      font-size: 0.8rem;
      font-weight: 700;
      background: var(--surface-hover);
      border: 1px solid var(--border);
      color: var(--text);
      border-radius: 0.35rem;
      cursor: pointer;
    }
    .cart-remove-btn {
      padding: 0.15rem 0.45rem;
      font-size: 0.76rem;
      background: rgba(239, 68, 68, 0.18);
      border: 1px solid rgba(239, 68, 68, 0.4);
      color: #f87171;
      border-radius: 0.35rem;
      cursor: pointer;
    }
    .cart-total-bar {
      display: flex;
      justify-content: space-between;
      align-items: center;
      padding-top: 0.45rem;
      border-top: 1px dashed var(--border);
      font-size: 0.9rem;
    }
    .closed-order-notice {
      background: rgba(245, 158, 11, 0.12);
      border: 1px solid rgba(245, 158, 11, 0.4);
      border-radius: 0.55rem;
      padding: 0.75rem;
      margin-bottom: 0.75rem;
      font-size: 0.82rem;
      color: #fde68a;
      display: none;
    }
    .other-pending-alert {
      background: rgba(245, 158, 11, 0.14);
      border: 1px solid rgba(245, 158, 11, 0.45);
      border-radius: 0.55rem;
      padding: 0.6rem 0.8rem;
      margin-bottom: 0.75rem;
      font-size: 0.8rem;
      color: #fbbf24;
      display: none;
      justify-content: space-between;
      align-items: center;
      gap: 0.5rem;
      flex-wrap: wrap;
    }

    #toast {
      position: fixed;
      bottom: 1rem;
      right: 1rem;
      left: 1rem;
      max-width: 420px;
      margin: 0 auto;
      background: #1e293b;
      border: 1px solid var(--primary);
      padding: 0.75rem 1rem;
      border-radius: 0.55rem;
      display: none;
      z-index: 100;
      box-shadow: 0 10px 25px rgba(0,0,0,0.5);
      text-align: center;
      font-size: 0.86rem;
    }

    /* Ajustes específicos para Celular (Mobile) */
    html, body {
      overflow-x: hidden;
      max-width: 100vw;
      width: 100%;
    }

    @media (max-width: 768px) {
      body {
        padding: 0.5rem 0.55rem;
      }
      header {
        flex-direction: column;
        align-items: stretch;
        gap: 0.55rem;
        margin-bottom: 0.75rem;
        padding-bottom: 0.65rem;
      }
      .brand-box {
        gap: 0.55rem;
      }
      .brand-logo {
        width: 38px;
        height: 38px;
      }
      header h1 {
        font-size: 1.15rem;
        line-height: 1.25;
      }
      header p {
        font-size: 0.75rem;
      }
      .nav-tabs {
        width: 100%;
        overflow-x: auto;
        -webkit-overflow-scrolling: touch;
        scrollbar-width: none;
        justify-content: flex-start;
        padding: 0.22rem;
        gap: 0.25rem;
      }
      .nav-tabs::-webkit-scrollbar {
        display: none;
      }
      .nav-tab {
        flex: 0 0 auto;
        padding: 0.42rem 0.65rem;
        font-size: 0.78rem;
        white-space: nowrap;
      }
      .event-banner {
        flex-direction: column;
        align-items: stretch;
        padding: 0.65rem 0.75rem;
        gap: 0.55rem;
        width: 100%;
        min-width: 0;
      }
      .event-banner-left {
        display: flex;
        align-items: flex-end;
        justify-content: space-between;
        gap: 0.5rem;
        width: 100%;
        min-width: 0;
      }
      #active-event-select {
        min-width: 0 !important;
        width: 100% !important;
      }
      .event-banner-metrics {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 0.35rem;
        width: 100%;
      }
      .metric-chip {
        justify-content: center;
        padding: 0.28rem 0.35rem;
        font-size: 0.72rem;
        text-align: center;
        min-width: 0;
      }
      .stats-row {
        grid-template-columns: 1fr 1fr;
        gap: 0.5rem;
        margin-bottom: 0.75rem;
        width: 100%;
        min-width: 0;
      }
      .stats-row .stat-card:nth-child(3) {
        grid-column: 1 / -1;
      }
      .stat-card {
        padding: 0.55rem 0.7rem;
        border-radius: 0.55rem;
        min-width: 0;
        box-sizing: border-box;
      }
      .stat-card span {
        font-size: 0.7rem;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
      }
      .stat-card strong {
        font-size: 1.15rem;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
        display: block;
      }
      .stat-card small {
        font-size: 0.7rem;
        display: block;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
      }
      .grid-2 {
        grid-template-columns: 1fr;
        gap: 0.75rem;
        width: 100%;
        max-width: 100%;
        min-width: 0;
      }
      .card {
        padding: 0.75rem;
        border-radius: 0.65rem;
        width: 100%;
        max-width: 100%;
        min-width: 0;
        box-sizing: border-box;
      }
      .card h2 {
        font-size: 0.94rem;
        margin-bottom: 0.65rem;
        padding-bottom: 0.42rem;
      }
      .event-metrics-grid {
        grid-template-columns: 1fr 1fr;
        gap: 0.35rem;
      }
      .event-metric-box {
        padding: 0.4rem 0.5rem;
        min-width: 0;
      }
      .event-metric-box small {
        font-size: 0.66rem;
      }
      .event-metric-box strong {
        font-size: 0.88rem;
      }
      .event-item {
        padding: 0.75rem;
        border-radius: 0.6rem;
        width: 100%;
        min-width: 0;
        box-sizing: border-box;
      }
      .event-actions {
        width: 100%;
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(110px, 1fr));
        gap: 0.35rem;
        margin-top: 0.4rem;
      }
      .event-actions button {
        width: 100%;
        text-align: center;
        padding: 0.38rem 0.45rem;
        font-size: 0.75rem;
      }
      .product-add-row {
        grid-template-columns: 80px 1fr !important;
      }
      .product-add-row > div:first-child {
        grid-column: 1 / -1;
      }
      .btn-add-item {
        width: 100%;
      }
      input, select, button {
        padding: 0.48rem 0.62rem;
        font-size: 0.84rem;
        max-width: 100%;
        box-sizing: border-box;
      }
      th, td {
        padding: 0.42rem 0.28rem;
        font-size: 0.78rem;
      }
      table {
        min-width: 290px;
      }
      .test-mode-banner {
        padding: 0.55rem 0.75rem;
      }
      .test-banner-content {
        flex-direction: column;
        align-items: stretch;
        text-align: center;
        gap: 0.45rem;
      }
      .test-banner-actions {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 0.35rem;
        width: 100%;
      }
      .btn-test-action {
        width: 100%;
        text-align: center;
        padding: 0.35rem 0.45rem;
        font-size: 0.74rem;
      }
    }

    @media (max-width: 360px) {
      .stats-row {
        grid-template-columns: 1fr;
      }
      .event-banner-metrics {
        grid-template-columns: 1fr;
      }
    }

    /* Estilos do Modo Teste e Badges de Ambiente */
    .test-mode-banner {
      background: linear-gradient(90deg, #b45309, #d97706);
      color: #fff;
      padding: 0.65rem 0.95rem;
      border-radius: 0.65rem;
      margin-bottom: 0.85rem;
      box-shadow: 0 4px 14px rgba(217, 119, 6, 0.28);
      border: 1px solid rgba(251, 191, 36, 0.45);
    }
    .test-banner-content {
      display: flex;
      justify-content: space-between;
      align-items: center;
      gap: 0.65rem;
      flex-wrap: wrap;
      font-size: 0.84rem;
    }
    .test-banner-actions {
      display: flex;
      gap: 0.45rem;
      flex-wrap: wrap;
    }
    .btn-test-action {
      background: rgba(0, 0, 0, 0.35);
      border: 1px solid rgba(255, 255, 255, 0.4);
      color: #fff;
      padding: 0.32rem 0.65rem;
      font-size: 0.78rem;
      border-radius: 0.4rem;
      cursor: pointer;
      font-weight: 600;
      transition: background 0.15s;
    }
    .btn-test-action:hover {
      background: rgba(0, 0, 0, 0.55);
    }
    .btn-test-exit {
      background: #0f172a;
      border-color: #fbbf24;
      color: #fde68a;
    }
    .btn-test-exit:hover {
      background: #1e293b;
    }
    .env-pill {
      font-size: 0.64rem;
      padding: 0.12rem 0.44rem;
      border-radius: 999px;
      font-weight: 700;
      letter-spacing: 0.05em;
      text-transform: uppercase;
      margin-left: 0.35rem;
      vertical-align: middle;
      display: inline-block;
    }
    .env-pill-prod {
      background: rgba(16, 185, 129, 0.18);
      color: #34d399;
      border: 1px solid rgba(16, 185, 129, 0.45);
    }
    .env-pill-test {
      background: rgba(245, 158, 11, 0.25);
      color: #fbbf24;
      border: 1px solid rgba(245, 158, 11, 0.6);
    }
  </style>
</head>
<body>
  <header>
    <div class="brand-box">
      <img src="./icon-192.png?v=3" alt="Detroit Jovens" class="brand-logo" />
      <div>
        <h1 style="display:flex;align-items:center;flex-wrap:wrap;gap:0.35rem;">
          Controle Social Jovens
          <span id="brand-env-badge" class="env-pill env-pill-prod">PROD</span>
        </h1>
        <p>Eventos, Adesão, Pedidos e Produtos</p>
      </div>
    </div>
    <nav class="nav-tabs" aria-label="Navegação Principal">
      <button type="button" class="nav-tab" id="tab-events" onclick="switchScreen('events')">
        📅 Eventos & Adesão
      </button>
      <button type="button" class="nav-tab active" id="tab-orders" onclick="switchScreen('orders')">
        🛒 Caixa / Pedidos
      </button>
      <button type="button" class="nav-tab" id="tab-products" onclick="switchScreen('products')">
        📦 Produtos
      </button>
